import { Theme } from "theme.slint";

component FocusableClickArea {
    in property <bool> enabled: true;
    out property <bool> has-focus: focus-scope.has-focus;
    out property <bool> has-hover: touch-area.has-hover;
    out property <bool> pressed: touch-area.pressed;
    callback clicked();

    forward-focus: focus-scope;

    touch-area := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus-scope.focus();
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        enabled: root.enabled;
        width: 0px;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected: false;
    callback activated();

    forward-focus: interaction;
    height: 40px;
    border-radius: 10px;
    border-width: interaction.has-focus ? 2px : 0px;
    border-color: Theme.blurple;
    background: selected ? Theme.blurple-soft : interaction.has-hover ? Theme.surface-raised : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;
        Text {
            text: glyph;
            color: selected ? Theme.blurple-ink : Theme.ink-subtle;
            font-size: 15px;
            vertical-alignment: center;
        }
        Text {
            text: label;
            color: selected ? Theme.blurple-ink : Theme.ink;
            font-size: 14px;
            font-weight: selected ? 650 : 500;
            vertical-alignment: center;
        }
    }

    interaction := FocusableClickArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(); }
    }
}

export component SegmentTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback activated();

    forward-focus: interaction;
    height: 36px;
    min-width: 92px;
    border-radius: 9px;
    border-width: interaction.has-focus ? 2px : 1px;
    border-color: interaction.has-focus ? Theme.blurple : selected ? Theme.blurple : Theme.border;
    background: selected ? Theme.blurple-soft : interaction.has-hover ? Theme.surface-raised : Theme.surface;
    accessible-role: button;
    accessible-label: label + (selected ? ", selected" : "");
    accessible-action-default => { root.activated(); }

    Text {
        text: label;
        color: selected ? Theme.blurple-ink : Theme.ink-subtle;
        font-size: 11px;
        font-weight: selected ? 650 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    interaction := FocusableClickArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(); }
    }
}

export component HonestyPanel inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <color> accent: Theme.amber;

    min-height: 116px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    accessible-role: groupbox;
    accessible-label: title + ". " + body;

    HorizontalLayout {
        padding: 16px;
        spacing: 12px;
        Rectangle { width: 4px; border-radius: 2px; background: accent; }
        VerticalLayout {
            spacing: 6px;
            Text { text: title; color: Theme.ink; font-size: 13px; font-weight: 650; }
            Text { text: body; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
        }
    }
}

export component QuickAction inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> glyph;
    in property <color> accent: Theme.blurple;
    callback activated();

    forward-focus: interaction;
    min-width: 170px;
    height: 76px;
    border-radius: 14px;
    border-width: interaction.has-focus ? 2px : 1px;
    border-color: interaction.has-focus ? Theme.blurple : Theme.border;
    background: interaction.has-hover ? Theme.surface-raised : Theme.surface;
    accessible-role: button;
    accessible-label: title + ". " + subtitle;
    accessible-action-default => { root.activated(); }

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        alignment: start;
        Text {
            width: 28px;
            text: glyph;
            color: accent;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text { text: title; color: Theme.ink; font-size: 13px; font-weight: 650; }
            Text { text: subtitle; color: Theme.ink-subtle; font-size: 11px; }
        }
    }

    interaction := FocusableClickArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(); }
    }
}

export component ToolbarAction inherits Rectangle {
    in property <string> label;
    in property <string> glyph: "✦";
    callback activated();

    forward-focus: interaction;
    height: 44px;
    min-width: 132px;
    border-radius: 11px;
    border-width: interaction.has-focus ? 2px : 0px;
    border-color: Theme.blurple;
    background: interaction.has-hover ? #E5E4FF : Theme.blurple-soft;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text { text: glyph; color: Theme.blurple-ink; font-size: 15px; vertical-alignment: center; }
        Text { text: label; color: Theme.ink; font-size: 12px; font-weight: 650; vertical-alignment: center; }
    }

    interaction := FocusableClickArea {
        width: 100%;
        height: 100%;
        clicked => { root.activated(); }
    }
}

export component MetricCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> delta;
    in property <string> glyph;
    in property <color> accent: Theme.blurple;

    min-width: 170px;
    height: 102px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    accessible-role: text;
    accessible-label: label + ": " + value + ". " + delta;

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: glyph; color: accent; font-size: 15px; }
            Text { text: label; color: Theme.ink-subtle; font-size: 12px; vertical-alignment: center; }
        }
        Text { text: value; color: Theme.ink; font-size: 24px; font-weight: 700; }
        Text { text: delta; color: Theme.pine; font-size: 11px; font-weight: 600; }
    }
}

export component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> accent: Theme.mint;
    height: 24px;
    min-width: 72px;
    border-radius: 12px;
    background: accent.with-alpha(0.12);
    accessible-role: text;
    accessible-label: label;
    Text {
        text: label;
        color: Theme.ink;
        font-size: 10px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

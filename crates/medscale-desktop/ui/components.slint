import { Theme } from "theme.slint";

component FocusableClickArea {
    in property <bool> enabled: true;
    out property <bool> has-focus: focus-scope.has-focus;
    out property <bool> has-hover: touch-area.has-hover;
    out property <bool> pressed: touch-area.pressed;
    callback clicked();

    forward-focus: focus-scope;
    touch-area := TouchArea {
        enabled: root.enabled;
        clicked => { focus-scope.focus(); root.clicked(); }
    }
    focus-scope := FocusScope {
        enabled: root.enabled;
        width: 0px;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected: false;
    callback activated();

    forward-focus: interaction;
    height: 34px;
    border-radius: 9px;
    border-width: interaction.has-focus ? 1px : 0px;
    border-color: Theme.signal;
    background: selected ? Theme.graphite-raised : interaction.has-hover ? Theme.graphite : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 11px;
        alignment: start;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: selected ? Theme.signal : Theme.nav-subtle.with-alpha(0.48);
        }
        Text {
            text: label;
            color: selected ? Theme.nav-text : Theme.nav-subtle;
            font-size: 12px;
            font-weight: selected ? 650 : 520;
        }
    }

    interaction := FocusableClickArea {
        width: 100%; height: 100%;
        clicked => { root.activated(); }
    }
}

export component SegmentTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback activated();

    forward-focus: interaction;
    height: 34px;
    min-width: 92px;
    border-radius: 8px;
    border-width: interaction.has-focus ? 2px : 1px;
    border-color: interaction.has-focus ? Theme.signal : selected ? Theme.signal : Theme.border;
    background: selected ? Theme.signal-soft : interaction.has-hover ? Theme.surface-raised : Theme.surface;
    accessible-role: button;
    accessible-label: label + (selected ? ", selected" : "");
    accessible-action-default => { root.activated(); }

    Text {
        text: label;
        color: selected ? Theme.signal-strong : Theme.ink-subtle;
        font-size: 11px;
        font-weight: selected ? 650 : 520;
        horizontal-alignment: center;

    }
    interaction := FocusableClickArea { width: 100%; height: 100%; clicked => { root.activated(); } }
}

export component HonestyPanel inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <color> accent: Theme.warning;

    min-height: 112px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    accessible-role: groupbox;
    accessible-label: title + ". " + body;

    HorizontalLayout {
        padding: 15px;
        spacing: 12px;
        Rectangle { width: 3px; border-radius: 1px; background: accent; }
        VerticalLayout {
            spacing: 5px;
            Text { text: title; color: Theme.ink; font-size: 12px; font-weight: 650; }
            Text { text: body; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
        }
    }
}

export component QuickAction inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> glyph;
    in property <color> accent: Theme.signal;
    callback activated();

    forward-focus: interaction;
    min-width: 170px;
    height: 72px;
    border-radius: 12px;
    border-width: interaction.has-focus ? 2px : 1px;
    border-color: interaction.has-focus ? Theme.signal : Theme.border;
    background: interaction.has-hover ? Theme.surface-raised : Theme.surface;
    accessible-role: button;
    accessible-label: title + ". " + subtitle;
    accessible-action-default => { root.activated(); }

    HorizontalLayout {
        padding: 13px;
        spacing: 11px;
        Rectangle {
            width: 3px;
            height: 38px;
            border-radius: 2px;
            background: accent;
        }
        VerticalLayout {
            spacing: 3px;
            alignment: center;
            Text { text: title; color: Theme.ink; font-size: 12px; font-weight: 650; }
            Text { text: subtitle; color: Theme.ink-subtle; font-size: 10px; }
        }
    }
    interaction := FocusableClickArea { width: 100%; height: 100%; clicked => { root.activated(); } }
}

export component ToolbarAction inherits Rectangle {
    in property <string> label;
    in property <string> glyph: "";
    callback activated();

    forward-focus: interaction;
    height: 40px;
    min-width: 112px;
    border-radius: 9px;
    border-width: interaction.has-focus ? 2px : 1px;
    border-color: interaction.has-focus ? Theme.signal : Theme.border;
    background: interaction.has-hover ? Theme.signal-soft : Theme.surface;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }

    Text {
        text: label;
        color: Theme.ink;
        font-size: 11px;
        font-weight: 650;
        horizontal-alignment: center;

    }
    interaction := FocusableClickArea { width: 100%; height: 100%; clicked => { root.activated(); } }
}

export component MetricCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> delta;
    in property <string> glyph;
    in property <color> accent: Theme.signal;

    min-width: 170px;
    height: 98px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    accessible-role: text;
    accessible-label: label + ": " + value + ". " + delta;

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 7px; height: 7px; border-radius: 4px; background: accent; }
            Text { text: label; color: Theme.ink-subtle; font-size: 11px; }
        }
        Text { text: value; color: Theme.ink; font-size: 23px; font-weight: 700; }
        Text { text: delta; color: Theme.ink-quiet; font-size: 10px; font-weight: 550; }
    }
}

export component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> accent: Theme.success;
    height: 22px;
    min-width: 72px;
    border-radius: 11px;
    background: accent.with-alpha(0.10);
    accessible-role: text;
    accessible-label: label;
    Text {
        text: label;
        color: Theme.ink;
        font-size: 9px;
        font-weight: 650;
        horizontal-alignment: center;

    }
}

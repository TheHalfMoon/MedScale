export global Theme {
    // MedScale Signal — monochrome-first, one primary product accent.
    in property <color> signal: #0A66FF;
    in property <color> signal-hover: #0056D6;
    in property <color> signal-strong: #0047B3;
    in property <color> signal-soft: #EAF2FF;
    in property <color> signal-glow: #B8D5FF;

    in property <color> obsidian: #0A0E14;
    in property <color> graphite: #111822;
    in property <color> graphite-raised: #17212E;
    in property <color> nav-text: #F4F7FA;
    in property <color> nav-subtle: #96A3B5;

    in property <color> ink: #0D1420;
    in property <color> ink-subtle: #455468;
    in property <color> ink-quiet: #5E6D80;
    in property <color> border: #DCE3EB;
    in property <color> border-strong: #C7D0DC;
    in property <color> canvas: #F3F6F9;
    in property <color> surface: #FFFFFF;
    in property <color> surface-raised: #F8FAFC;

    in property <color> success: #0B8F69;
    in property <color> warning: #B87500;
    in property <color> danger: #C64242;


}

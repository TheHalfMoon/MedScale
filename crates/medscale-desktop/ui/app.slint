                                    Text { text: "Synthetic subjects only. Condition text is shown only when present in trusted presentation; unresolved status remains explicit."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                    Rectangle { height: 12px; background: transparent; }
                                    HorizontalLayout { height: 38px; spacing: 12px;
                                        Text { width: 160px; text: "SUBJECT"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                        Text { width: 210px; text: "CONDITION"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                        Text { horizontal-stretch: 1; text: "EVIDENCE STATE"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                        Text { width: 150px; text: "REVIEW"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; vertical-alignment: center; horizontal-alignment: right; }
                                    }

                                            Text { text: "anchor " + item.artifact-id + " · " + item.status; color: Theme.ink-quiet; font-size: 11px; }
                                        }
                                        StatusPill { label: item.resolution; accent: item.resolution == "current" ? Theme.success : item.resolution == "stale" || item.resolution == "missing" ? Theme.warning : Theme.danger; }
                                        QuickAction { width: 100px; title: "Open"; subtitle: "Messages"; glyph: ""; accent: Theme.signal; activated => { root.ui-action("collab-thread-select:" + item.id); } }

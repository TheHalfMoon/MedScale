                                                    Text { text: root.insights-assistant-answer; color: Theme.ink; font-size: 11px; wrap: word-wrap; }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                QuickAction { title: "Explain gaps"; subtitle: "Evidence state only"; glyph: "?"; accent: Theme.amber; activated => { root.ui-action("insights-assistant:Explain coverage gaps"); } }
                                                QuickAction { title: "Risk limits"; subtitle: "No clinical ranking"; glyph: "!"; accent: Theme.coral; activated => { root.ui-action("insights-assistant:Who is highest risk?"); } }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 16px;
                                    HonestyPanel { horizontal-stretch: 1; title: "Risk distribution boundary"; body: root.insights-risk-state; accent: Theme.coral; }
                                    HonestyPanel { horizontal-stretch: 1; title: "Trend boundary"; body: root.insights-trend-state; accent: Theme.blurple; }
                                }
                                HorizontalLayout {
                                    spacing: 16px;
                                    HonestyPanel { horizontal-stretch: 1; title: "Evidence gaps"; body: root.insights-gap-state; accent: Theme.amber; }
                                    HonestyPanel { horizontal-stretch: 1; title: "Review recommendation"; body: root.insights-recommendation-state; accent: Theme.pine; }
                                }

                                    padding-right: 10px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 6px;
                                    Text { text: "New run follows the active project"; color: Theme.ink; font-size: 12px; font-weight: 680; }
                                    Text { text: root.medagent-status; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.medagent-agent-id-input; placeholder: "Agent identity id"; accessible-name: "Agent identity id"; }
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.medagent-context-id-input; placeholder: "Context manifest id"; accessible-name: "Context manifest id"; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.medagent-prompt-input; placeholder: "Prompt"; accessible-name: "Run prompt"; }
                                        ToolbarAction { label: "Create + start"; activated => { root.ui-action("medagent-run-create-start"); } }
                                        ToolbarAction { label: "Refresh"; activated => { root.ui-action("medagent-runs-refresh"); } }
                                    }
                                }
                            }

                            Text { text: "Runs"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.medagent-runs: Rectangle {
                                min-height: 56px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Run " + item.id + ", " + item.status + ", revision " + item.revision;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: item.prompt; color: Theme.ink; font-size: 12px; font-weight: 680; wrap: word-wrap; }
                                        Text { text: item.id + " · rev " + item.revision; color: Theme.ink-quiet; font-size: 11px; }
                                    }
                                    StatusPill { label: item.status; accent: item.status == "completed" ? Theme.success : item.status == "cancelled" || item.status == "failed" ? Theme.danger : Theme.warning; }
                                    QuickAction { width: 100px; title: "Open"; subtitle: "Turns"; glyph: ""; accent: Theme.signal; activated => { root.ui-action("medagent-run-select:" + item.id + ":" + item.revision); } }
                                    if item.status == "pending" || item.status == "running": QuickAction { width: 100px; title: "Cancel"; subtitle: "Interrupt"; glyph: ""; accent: Theme.danger; activated => { root.ui-action("medagent-run-cancel:" + item.id + ":" + item.revision); } }
                                }
                            }

                            if root.medagent-active-run-id != "": VerticalLayout {
                                spacing: 8px;
                                Text { text: "Turns · " + root.medagent-active-run-id; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                for item in root.medagent-turns: Rectangle {
                                    min-height: 40px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: text;
                                    accessible-label: "Turn " + item.seq + ", " + item.kind;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        Text { width: 40px; text: item.seq; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { width: 120px; text: item.kind; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { horizontal-stretch: 1; text: item.payload; color: Theme.ink; font-size: 11px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }

                        if root.active-route == "Model Fleet": VerticalLayout {
                            spacing: 14px;
                            HonestyPanel { title: "Model Fleet boundary"; body: "Each lane runs its own governed MedAgent run under its bound identity, context and narrower lane policy · lanes never read each other's context · a comparison states facts grounded in lane receipts and proposals, never a score, rank or winner, and never promotes or acts on any output"; accent: Theme.success; }

                            Rectangle {
                                min-height: 120px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Fleet runs. " + root.fleet-status;
                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 6px;
                                    Text { text: "New fleet run follows the active project · lanes are created with the CLI"; color: Theme.ink; font-size: 12px; font-weight: 680; }
                                    Text { text: root.fleet-status; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.fleet-prompt-input; placeholder: "Task prompt for every lane"; accessible-name: "Fleet task prompt"; }
                                        ToolbarAction { label: "Create"; activated => { root.ui-action("fleet-create"); } }
                                        ToolbarAction { label: "Refresh"; activated => { root.ui-action("fleet-refresh"); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.fleet-lane-ids-input; placeholder: "Lane ids, comma-separated (2 to 8)"; accessible-name: "Fleet lane ids"; }
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.fleet-pack-dir-input; placeholder: "Absolute admitted Pack directory"; accessible-name: "Local Pack directory for fleet lanes"; }
                                    }
                                }
                            }

                            Text { text: "Lanes"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.fleet-lanes: Rectangle {
                                min-height: 40px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: text;
                                accessible-label: "Lane " + item.id + ", " + item.role + ", " + item.status;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; vertical-alignment: center; text: item.role; color: Theme.ink; font-size: 12px; font-weight: 680; wrap: word-wrap; }
                                    Text { vertical-alignment: center; text: item.id + " · rev " + item.revision; color: Theme.ink-quiet; font-size: 11px; }
                                    StatusPill { label: item.status; accent: item.status == "active" ? Theme.success : Theme.ink-quiet; }
                                }
                            }

                            Text { text: "Fleet runs"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.fleet-runs: Rectangle {
                                min-height: 56px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Fleet run " + item.id + ", " + item.status + ", revision " + item.revision;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; vertical-alignment: center; text: item.id + " · rev " + item.revision; color: Theme.ink; font-size: 12px; font-weight: 680; }
                                    StatusPill { label: item.status; accent: item.status == "completed" ? Theme.success : item.status == "partially_failed" ? Theme.warning : item.status == "failed" || item.status == "cancelled" ? Theme.danger : Theme.signal; }
                                    QuickAction { width: 100px; title: "Open"; subtitle: "Lanes"; glyph: ""; accent: Theme.signal; activated => { root.ui-action("fleet-open:" + item.id); } }
                                    if item.status == "pending": QuickAction { width: 100px; title: "Dispatch"; subtitle: "Lane ids"; glyph: ""; accent: Theme.success; activated => { root.ui-action("fleet-dispatch:" + item.id + ":" + item.revision); } }
                                    if item.status == "pending" || item.status == "running": QuickAction { width: 100px; title: "Cancel"; subtitle: "Every lane"; glyph: ""; accent: Theme.danger; activated => { root.ui-action("fleet-cancel:" + item.id + ":" + item.revision); } }
                                }
                            }

                            if root.fleet-active-id != "": VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { horizontal-stretch: 1; vertical-alignment: center; text: "Lanes of " + root.fleet-active-id + " · " + root.fleet-active-status; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                    if root.fleet-active-status == "completed" || root.fleet-active-status == "partially_failed": ToolbarAction { label: "Compare"; activated => { root.ui-action("fleet-compare:" + root.fleet-active-id); } }
                                }
                                for item in root.fleet-lane-runs: Rectangle {
                                    min-height: 48px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: groupbox;
                                    accessible-label: "Lane " + item.lane-id + ", run " + item.run-id + ", " + item.run-status;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 12px;
                                        Text { horizontal-stretch: 1; vertical-alignment: center; text: item.lane-id + " → " + item.run-id; color: Theme.ink; font-size: 12px; }
                                        StatusPill { label: item.run-status; accent: item.run-status == "completed" ? Theme.success : item.run-status == "failed" || item.run-status == "cancelled" ? Theme.danger : Theme.warning; }
                                        if item.run-status == "running": QuickAction { width: 100px; title: "Execute"; subtitle: "Local Pack"; glyph: ""; accent: Theme.signal; activated => { root.ui-action("fleet-execute:" + root.fleet-active-id + ":" + item.lane-id); } }
                                    }
                                }
                                if root.fleet-report-summary != "": Text { text: root.fleet-report-summary; color: Theme.ink-subtle; font-size: 12px; wrap: word-wrap; }
                                for item in root.fleet-observations: Rectangle {
                                    min-height: 40px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: text;
                                    accessible-label: "Observation " + item.kind + " for " + item.lanes + ": " + item.detail;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        Text { width: 170px; vertical-alignment: center; text: item.kind; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { width: 160px; vertical-alignment: center; text: item.lanes; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                        Text { horizontal-stretch: 1; vertical-alignment: center; text: item.detail; color: Theme.ink; font-size: 11px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }

                        if root.active-route == "Browse": VerticalLayout {
                            spacing: 14px;
                            HonestyPanel { title: "Governed Browse boundary"; body: "Only https hosts you allow for this project · private, loopback and cloud-metadata addresses are refused and every redirect is re-checked · project content never leaves without a Privacy Gate allow · pages are stored as evidence and never change instructions · no forms, logins or purchases"; accent: Theme.success; }

                            Rectangle {
                                min-height: 140px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Governed Browse. " + root.browse-status;
                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 6px;
                                    Text { text: "Allowlist and fetch follow the active project"; color: Theme.ink; font-size: 12px; font-weight: 680; }
                                    Text { text: root.browse-status; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.browse-host-input; placeholder: "Host, e.g. pubmed.ncbi.nlm.nih.gov"; accessible-name: "Allowed host"; }
                                        AdaptiveLineEdit { width: 160px; text <=> root.browse-prefix-input; placeholder: "Path prefix"; accessible-name: "Allowed path prefix"; }
                                        ToolbarAction { label: "Allow"; activated => { root.ui-action("browse-allow-add"); } }
                                        ToolbarAction { label: "Refresh"; activated => { root.ui-action("browse-refresh"); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.browse-url-input; placeholder: "https URL on an allowed host"; accessible-name: "URL to fetch"; }
                                        ToolbarAction { label: "Fetch"; activated => { root.ui-action("browse-fetch"); } }
                                    }
                                    if root.browse-last-result != "": Text { text: root.browse-last-result; color: Theme.ink; font-size: 11px; wrap: word-wrap; accessible-role: text; accessible-label: "Last fetch: " + root.browse-last-result; }
                                    if root.browse-last-excerpt != "": Text { text: root.browse-last-excerpt; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; accessible-role: text; accessible-label: "Evidence excerpt: " + root.browse-last-excerpt; }
                                }
                            }

                            Text { text: "Allowed targets"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.browse-allowlist: Rectangle {
                                min-height: 44px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Allowed target " + item.target + (item.enabled ? ", enabled" : ", disabled");
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; vertical-alignment: center; text: item.target + " · rev " + item.revision; color: Theme.ink; font-size: 12px; }
                                    StatusPill { label: item.enabled ? "enabled" : "disabled"; accent: item.enabled ? Theme.success : Theme.ink-quiet; }
                                    if item.enabled: QuickAction { width: 100px; title: "Disable"; subtitle: "Stops fetches"; glyph: ""; accent: Theme.danger; activated => { root.ui-action("browse-allow-disable:" + item.id + ":" + item.revision); } }
                                }
                            }

                            Text { text: "Sessions (newest first)"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.browse-sessions: Rectangle {
                                min-height: 40px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: text;
                                accessible-label: "Session " + item.id + ", " + item.state + " " + item.reason + ", " + item.url;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; vertical-alignment: center; text: item.url; color: Theme.ink; font-size: 12px; wrap: word-wrap; }
                                    Text { vertical-alignment: center; text: item.reason; color: Theme.ink-quiet; font-size: 11px; }
                                    StatusPill { label: item.state; accent: item.state == "completed" ? Theme.success : item.state == "awaiting_human_takeover" ? Theme.warning : Theme.danger; }
                                }
                            }
                        }

                        if root.active-route == "Knowledge": VerticalLayout {
                            spacing: 14px;
                            HonestyPanel { title: "Knowledge boundary"; body: "The index is a rebuildable projection, never a source of truth · every match names the exact source revision and span it came from · superseded and archived sources are labelled and archived text is never shown · no match is reported as insufficient evidence · retrieval is lexical only; no vector or model ranking runs here"; accent: Theme.success; }

                            Rectangle {
                                min-height: 120px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Knowledge. " + root.knowledge-status;
                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { horizontal-stretch: 1; text: "Search follows the active project"; color: Theme.ink; font-size: 12px; font-weight: 680; }
                                        ToolbarAction { label: "Refresh"; activated => { root.ui-action("knowledge-refresh"); } }
                                        ToolbarAction { label: "Build index"; activated => { root.ui-action("knowledge-build"); } }
                                    }
                                    Text { text: root.knowledge-status; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.knowledge-query-input; placeholder: "Search words, e.g. myalgia statin"; accessible-name: "Knowledge search query"; }
                                        ToolbarAction { label: "Search"; activated => { root.ui-action("knowledge-search"); } }
                                    }
                                    if root.knowledge-last-result != "": Text { text: root.knowledge-last-result; color: Theme.ink; font-size: 11px; wrap: word-wrap; accessible-role: text; accessible-label: "Last search: " + root.knowledge-last-result; }
                                    if root.knowledge-hits != "": Text { text: root.knowledge-hits; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; accessible-role: text; accessible-label: "Matches: " + root.knowledge-hits; }
                                }
                            }

                            Text { text: "Research canvases"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.knowledge-canvases: Rectangle {
                                min-height: 40px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: text;
                                accessible-label: "Canvas " + item.title + ", " + item.detail;
                                HorizontalLayout {

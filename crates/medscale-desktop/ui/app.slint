                                    Text { vertical-alignment: center; text: item.id; color: Theme.ink-quiet; font-size: 11px; }
                                }
                            }
                        }

                        if root.active-route == "Analytics": VerticalLayout {
                            spacing: 14px;
                            HonestyPanel { title: "Analytics boundary"; body: "Queries are read-only: writes, schema changes, attachments and pragmas are refused · every run pins the exact snapshots it read and leaves a receipt · truncated or partial-input results are labelled as such · no R, Python or shell runs here"; accent: Theme.success; }

                            Rectangle {
                                min-height: 120px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Analytics. " + root.analytics-status;
                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 6px;

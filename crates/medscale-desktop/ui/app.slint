                                        spacing: 8px;
                                        Text { horizontal-stretch: 1; text: "Queries follow the active project"; color: Theme.ink; font-size: 12px; font-weight: 680; }
                                        ToolbarAction { label: "Refresh"; activated => { root.ui-action("analytics-refresh"); } }
                                    }
                                    Text { text: root.analytics-status; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    AdaptiveLineEdit { text <=> root.analytics-bindings-input; placeholder: "Bindings, e.g. labs=snap-1"; accessible-name: "Snapshot bindings"; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.analytics-sql-input; placeholder: "SELECT ... FROM labs"; accessible-name: "Read-only SQL query"; }
                                        ToolbarAction { label: "Run"; activated => { root.ui-action("analytics-run"); } }
                                    }
                                    if root.analytics-last-result != "": Text { text: root.analytics-last-result; color: Theme.ink; font-size: 11px; wrap: word-wrap; accessible-role: text; accessible-label: "Last run: " + root.analytics-last-result; }
                                    if root.analytics-preview != "": Text { text: root.analytics-preview; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; accessible-role: text; accessible-label: "Result preview: " + root.analytics-preview; }
                                }
                            }

                            Text { text: "Query receipts (newest first)"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.analytics-receipts: Rectangle {

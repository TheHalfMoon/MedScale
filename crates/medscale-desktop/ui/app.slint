import { AboutSlint, ScrollView } from "std-widgets.slint";
import "../../../assets/brand/fonts/InstrumentSans-Regular.ttf";
import "../../../assets/brand/fonts/InstrumentSans-Medium.ttf";
import "../../../assets/brand/fonts/InstrumentSans-SemiBold.ttf";
import "../../../assets/brand/fonts/InstrumentSans-Bold.ttf";
import "../../../assets/brand/fonts/SourceSerif4-Regular.ttf";
import "../../../assets/brand/fonts/SourceSerif4-Semibold.ttf";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
import { AdaptiveLineEdit, HonestyPanel, NavItem, QuickAction, RailAction, SearchField, SegmentTab, ToolbarAction, MetricCard, StatusPill } from "components.slint";

export struct PatientTimelineItem {
    date: string,
    title: string,
    detail: string,
    source: string,
    status: string,
}

export struct PatientLabItem {
    label: string,
    value: string,
    unit: string,
    status: string,
    source: string,
}

export struct PatientSourceItem {
    source-id: string,
    note: string,
}

export struct PopulationDistributionItem {
    label: string,
    value: string,
    detail: string,
    status: string,
}

export struct PopulationCohortItem {
    name: string,
    subject-ref: string,
    condition: string,
    evidence-state: string,
    review-attention: string,
}

export struct AssistantEvidenceItem {
    source: string,
    title: string,
    snippet: string,
    metadata: string,
}

export struct WorkflowStepItem {
    order: string,
    title: string,
    detail: string,
    state: string,
}

export struct WorkflowTaskItem {
    action-id: string,
    title: string,
    state: string,
    payload-digest: string,
    next-step: string,
    reconcile-required: bool,
}

export struct WorkflowMessageItem {
    title: string,
    body: string,
    status: string,
    related-action-id: string,
}

export struct UtilityStatusItem {
    label: string,
    value: string,
    detail: string,
    status: string,
}

export struct AuditTrailItem {
    record-id: string,
    action: string,
    subject: string,
    detail: string,
    status: string,
}

export struct ModelStatusItem {
    scope: string,
    task: string,
    model: string,
    source: string,
    runtime: string,
    device: string,
    trust: string,
    benchmark: string,
    digest: string,
    state: string,
}

export struct CompetitiveEvidenceItem {
    capability: string,
    medscale: string,
    openmed: string,
    verdict: string,
    evidence: string,
    limitations: string,
}

export struct ProjectRowItem {
    id: string,
    name: string,
    status: string,
    revision: string,
    experiments: string,
    refs: string,
    edges: string,
}

export struct ExperimentRowItem {
    id: string,
    name: string,
    status: string,
    revision: string,
}

export struct RefRowItem {
    ref-id: string,
    kind: string,
    object-id: string,
    resolution: string,
}

export struct EdgeRowItem {
    edge-id: string,
    subject: string,
    predicate: string,
    object: string,
    revision: string,
}

export struct DataSourceRowItem {
    id: string,
    name: string,
    kind: string,
    health: string,
    revision: string,
}

export struct SnapshotRowItem {
    id: string,
    rows: string,
    digest: string,
}

export struct WorkbenchRowItem {
    text: string,
}

export struct RoomRowItem {
    id: string,
    name: string,
    revision: string,
}

export struct ThreadRowItem {
    id: string,
    status: string,
    resolution: string,
    artifact-id: string,
}

export struct MessageRowItem {
    author: string,
    body: string,
    seq: string,
}

export struct TaskRowItem {
    id: string,
    title: string,
    status: string,
    revision: string,
}

export struct AgentRunRowItem {
    id: string,
    status: string,
    revision: string,
    prompt: string,
}

export struct FleetLaneRowItem {
    id: string,
    role: string,
    status: string,
    revision: string,
}

export struct FleetRunRowItem {
    id: string,
    status: string,
    revision: string,
}

export struct FleetLaneRunRowItem {
    lane-id: string,
    run-id: string,
    run-status: string,
}

export struct FleetObservationRowItem {
    kind: string,
    lanes: string,
    detail: string,
}

export struct KnowledgeCanvasRowItem {
    id: string,
    title: string,
    detail: string,
}

export struct AnalyticsReceiptRowItem {
    id: string,
    outcome: string,
    detail: string,
}

export struct AudioSourceRowItem {
    id: string,
    label: string,
    kind: string,
    detail: string,
    health: string,
}

export struct AudioCaptureRowItem {
    id: string,
    label: string,
    state: string,
    detail: string,
}

export struct BrowseAllowRowItem {
    id: string,
    target: string,
    enabled: bool,
    revision: string,
}

export struct BrowseSessionRowItem {
    id: string,
    url: string,
    state: string,
    reason: string,
}

export struct PrivacyClassificationRowItem {
    artifact-id: string,
    data-class: string,
    basis: string,
    revision: string,
}

export struct PrivacyReceiptRowItem {
    id: string,
    source: string,
    output: string,
    status: string,
    residual: string,
    revision: string,
}

export struct PrivacyDecisionRowItem {
    artifact-id: string,
    boundary: string,
    outcome: string,
    reason: string,
}

export struct AgentTurnRowItem {
    seq: string,
    kind: string,
    payload: string,
}

export component AppWindow inherits Window {
    title: "MedScale";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1100px;
    min-height: 720px;
    background: Theme.canvas;
    default-font-family: "Instrument Sans";
    default-font-size: 14px;

    in-out property <string> active-route: "Home";
    in-out property <bool> palette-open: false;
    in-out property <string> patient-tab: "Overview";
    in property <string> product-version: "0.1.0";
    in property <string> patient-name: "Synthetic subject";
    in property <string> patient-subject-ref: "synthetic-subject";
    in property <string> patient-birth-date: "Unknown — not inferred";
    in property <string> patient-condition-summary: "No supported condition facts in this projection";
    in property <string> patient-coverage-summary: "No coverage summary";
    in property <string> patient-coverage-state: "Unknown";
    in property <[PatientTimelineItem]> patient-timeline;
    in property <[PatientLabItem]> patient-labs;
    in property <[PatientSourceItem]> patient-sources;
    in property <string> patient-medications-state;
    in property <string> patient-documents-state;
    in property <string> patient-care-plan-state;
    in-out property <string> insights-tab: "Overview";
    in property <string> insights-cohort-size: "0";
    in property <string> insights-review-attention: "0";
    in property <string> insights-evidence-gaps: "0";
    in property <string> insights-present-count: "0";
    in property <[PopulationDistributionItem]> insights-conditions;
    in property <[PopulationDistributionItem]> insights-coverage;
    in property <[PopulationCohortItem]> insights-cohorts;
    in property <[AssistantEvidenceItem]> insights-evidence;
    in property <string> insights-risk-state;
    in property <string> insights-trend-state;
    in property <string> insights-gap-state;
    in property <string> insights-recommendation-state;
    in-out property <string> insights-assistant-answer;
    in property <string> workflow-name;
    in property <string> workflow-state;
    in property <string> workflow-outbox-summary;
    in property <string> workflow-action-boundary;
    in property <string> workflow-task-boundary;
    in property <string> workflow-message-boundary;
    in-out property <string> workflow-review-detail;
    in property <[WorkflowStepItem]> workflow-steps;
    in property <[WorkflowTaskItem]> workflow-tasks;
    in property <[WorkflowMessageItem]> workflow-messages;
    in property <string> utility-audit-boundary;
    in property <string> utility-export-boundary;
    in property <string> utility-settings-boundary;
    in property <string> utility-integrations-boundary;
    in property <string> utility-missing-release-evidence;
    in property <[AuditTrailItem]> utility-audit-rows;
    in property <[UtilityStatusItem]> utility-export-rows;
    in property <[UtilityStatusItem]> utility-settings-rows;
    in property <[UtilityStatusItem]> utility-integration-rows;
    in property <string> model-runtime-summary;
    in property <string> model-runtime-boundary;
    in property <string> model-source-summary;
    in property <string> model-inventory-summary;
    in-out property <string> model-pack-path: "";
    in property <string> model-operator-status: "Ready for local Pack inspection";
    in property <string> openmed-baseline;
    in property <string> competitive-summary;
    in property <[ModelStatusItem]> model-rows;
    in property <[CompetitiveEvidenceItem]> competitive-evidence-rows;
    in property <[ProjectRowItem]> project-rows;
    in-out property <string> project-status: "Projects not loaded";
    in-out property <string> project-name-input: "";
    in-out property <string> project-desc-input: "";
    in-out property <string> project-active-id: "";
    in-out property <string> project-active-revision: "";
    in property <string> project-detail-name: "";
    in property <string> project-detail-meta: "";
    in property <[ExperimentRowItem]> project-experiments;
    in property <[RefRowItem]> project-refs;
    in property <[EdgeRowItem]> project-edges;
    in-out property <string> project-experiment-input: "";
    in-out property <string> data-status: "Data not loaded";
    in property <[DataSourceRowItem]> data-sources;
    in property <[SnapshotRowItem]> data-snapshots;
    in-out property <string> data-active-source: "";
    in-out property <string> data-active-snapshot: "";
    in property <string> data-schema-line: "";
    in property <[WorkbenchRowItem]> data-rows;
    in property <string> data-detail: "";
    in property <string> data-next-cursor: "";
    in-out property <string> data-columns-input: "";
    in-out property <string> data-filter-col: "";
    in-out property <string> data-filter-op: "equals";
    in-out property <string> data-filter-value: "";
    in-out property <string> data-sort-input: "";
    in-out property <string> collab-status: "Rooms not loaded";
    in property <[RoomRowItem]> collab-rooms;
    in-out property <string> collab-room-name-input: "";
    in-out property <string> collab-active-room-id: "";
    in property <[ThreadRowItem]> collab-threads;
    in-out property <string> collab-active-thread-id: "";
    in-out property <string> collab-thread-artifact-input: "";
    in property <[MessageRowItem]> collab-messages;
    in-out property <string> collab-message-input: "";
    in property <[TaskRowItem]> collab-tasks;
    in-out property <string> collab-task-title-input: "";
    in-out property <string> medagent-status: "Runs not loaded";
    in property <[AgentRunRowItem]> medagent-runs;
    in-out property <string> medagent-agent-id-input: "";
    in-out property <string> medagent-context-id-input: "";
    in-out property <string> medagent-prompt-input: "";
    in-out property <string> medagent-active-run-id: "";
    in-out property <string> medagent-active-run-revision: "";
    in property <[AgentTurnRowItem]> medagent-turns;
    in-out property <string> fleet-status: "Fleet runs not loaded";
    in property <[FleetLaneRowItem]> fleet-lanes;
    in property <[FleetRunRowItem]> fleet-runs;
    in-out property <string> fleet-prompt-input: "";
    in-out property <string> fleet-lane-ids-input: "";
    in-out property <string> fleet-pack-dir-input: "";
    in-out property <string> fleet-active-id: "";
    in-out property <string> fleet-active-status: "";
    in-out property <string> fleet-active-revision: "";
    in property <[FleetLaneRunRowItem]> fleet-lane-runs;
    in-out property <string> fleet-report-summary: "";
    in property <[FleetObservationRowItem]> fleet-observations;
    in-out property <string> analytics-status: "Analytics not loaded";
    in property <[AnalyticsReceiptRowItem]> analytics-receipts;
    in-out property <string> analytics-sql-input: "";
    in-out property <string> analytics-bindings-input: "";
    in-out property <string> analytics-last-result: "";
    in-out property <string> analytics-preview: "";
    in-out property <string> knowledge-status: "Knowledge not loaded";
    in property <[KnowledgeCanvasRowItem]> knowledge-canvases;
    in-out property <string> knowledge-query-input: "";
    in-out property <string> knowledge-last-result: "";
    in-out property <string> knowledge-hits: "";
    in-out property <string> audio-status: "AudioFlow not loaded";
    in-out property <string> audio-native-capture: "";
    in property <[AudioSourceRowItem]> audio-sources;
    in property <[AudioCaptureRowItem]> audio-captures;
    in-out property <string> audio-last-result: "";
    in-out property <string> audio-transcript: "";
    in-out property <string> browse-status: "Browse not loaded";
    in property <[BrowseAllowRowItem]> browse-allowlist;
    in property <[BrowseSessionRowItem]> browse-sessions;
    in-out property <string> browse-host-input: "";
    in-out property <string> browse-prefix-input: "/";
    in-out property <string> browse-url-input: "";
    in-out property <string> browse-last-result: "";
    in-out property <string> browse-last-excerpt: "";
    in-out property <string> privacy-status: "Privacy state not loaded";
    in property <[PrivacyClassificationRowItem]> privacy-classifications;
    in property <[PrivacyReceiptRowItem]> privacy-receipts;
    in property <[PrivacyDecisionRowItem]> privacy-decisions;
    in-out property <string> privacy-artifact-input: "";
    in-out property <string> privacy-boundary-input: "browse";
    in-out property <string> privacy-last-decision: "";
    callback ui-action(string);

    forward-focus: global-keys;

    global-keys := FocusScope {
        key-pressed(event) => {
            if ((event.modifiers.control || event.modifiers.meta) && (event.text == "k" || event.text == "K")) {
                root.palette-open = !root.palette-open;
                return accept;
            }
            if (event.text == Key.Escape) {
                root.palette-open = false;
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            spacing: 0px;

            rail := Rectangle {
                width: 58px;
                background: Theme.obsidian;

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 7px;

                    Rectangle {
                        height: 46px;
                        background: transparent;
                        Image {
                            source: @image-url("assets/medscale-mark.svg");
                            width: 36px;
                            height: 36px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    RailAction {
                        label: "Home";
                        icon: @image-url("assets/icons/home.svg");
                        selected: root.active-route == "Home";
                        activated => { root.active-route = "Home"; }
                    }
                    RailAction {
                        label: "Patients and documents";
                        icon: @image-url("assets/icons/patients.svg");
                        selected: root.active-route == "Patients" || root.active-route == "Documents";
                        activated => { root.active-route = "Patients"; }
                    }
                    RailAction {
                        label: "Intelligence";
                        icon: @image-url("assets/icons/intelligence.svg");
                        selected: root.active-route == "Insights" || root.active-route == "Models" || root.active-route == "Evidence";
                        activated => { root.active-route = "Insights"; }
                    }
                    RailAction {
                        label: "Operations";
                        icon: @image-url("assets/icons/workflows.svg");
                        selected: root.active-route == "Workflows" || root.active-route == "Tasks" || root.active-route == "Messages";
                        activated => { root.active-route = "Workflows"; }
                    }
                    RailAction {
                        label: "Governance";
                        icon: @image-url("assets/icons/governance.svg");
                        selected: root.active-route == "Audit Trail" || root.active-route == "Exports" || root.active-route == "Integrations";
                        activated => { root.active-route = "Audit Trail"; }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    RailAction {
                        label: "Commands";
                        icon: @image-url("assets/icons/commands.svg");
                        activated => { root.palette-open = true; }
                    }
                    RailAction {
                        label: "Settings";
                        icon: @image-url("assets/icons/settings.svg");
                        selected: root.active-route == "Settings" || root.active-route == "About";
                        activated => { root.active-route = "Settings"; }
                    }
                }
            }

            sidebar := Rectangle {
                width: 204px;
                background: Theme.sidebar;
                border-width: 0px;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 15px;
                    padding-bottom: 14px;
                    spacing: 6px;

                    VerticalLayout {
                        height: 51px;
                        spacing: 1px;
                        Text { text: "MedScale"; color: Theme.ink; font-size: 16px; font-weight: 680; letter-spacing: -0.2px; }
                        Text { text: "CLINICAL INTELLIGENCE"; color: Theme.ink-quiet; font-size: 11px; letter-spacing: 1.05px; }
                    }

                    Text { text: "WORKSPACE"; color: Theme.ink-quiet; font-size: 11px; letter-spacing: 1.05px; }
                    NavItem { label: "Home"; selected: root.active-route == "Home"; activated => { root.active-route = "Home"; } }
                    NavItem { label: "Patients"; selected: root.active-route == "Patients"; activated => { root.active-route = "Patients"; } }
                    NavItem { label: "Documents"; selected: root.active-route == "Documents"; activated => { root.active-route = "Documents"; } }
                    NavItem { label: "Projects"; selected: root.active-route == "Projects"; activated => { root.active-route = "Projects"; } }
                    NavItem { label: "Data"; selected: root.active-route == "Data"; activated => { root.active-route = "Data"; } }

                    Rectangle { height: 4px; background: transparent; }
                    Text { text: "INTELLIGENCE"; color: Theme.ink-quiet; font-size: 11px; letter-spacing: 1.05px; }
                    NavItem { label: "Insights"; selected: root.active-route == "Insights"; activated => { root.active-route = "Insights"; } }
                    NavItem { label: "Models"; selected: root.active-route == "Models"; activated => { root.active-route = "Models"; } }
                    NavItem { label: "Evidence"; selected: root.active-route == "Evidence"; activated => { root.active-route = "Evidence"; } }

                    Rectangle { height: 4px; background: transparent; }
                    Text { text: "OPERATIONS"; color: Theme.ink-quiet; font-size: 11px; letter-spacing: 1.05px; }
                    NavItem { label: "Workflows"; selected: root.active-route == "Workflows"; activated => { root.active-route = "Workflows"; } }
                    NavItem { label: "Tasks"; selected: root.active-route == "Tasks"; activated => { root.active-route = "Tasks"; } }
                    NavItem { label: "Messages"; selected: root.active-route == "Messages"; activated => { root.active-route = "Messages"; } }
                    NavItem { label: "Collaboration"; selected: root.active-route == "Collaboration"; activated => { root.active-route = "Collaboration"; } }
                    NavItem { label: "MedAgent"; selected: root.active-route == "MedAgent"; activated => { root.active-route = "MedAgent"; } }
                    NavItem { label: "Model Fleet"; selected: root.active-route == "Model Fleet"; activated => { root.active-route = "Model Fleet"; } }
                    NavItem { label: "Browse"; selected: root.active-route == "Browse"; activated => { root.active-route = "Browse"; } }
                    NavItem { label: "Audio"; selected: root.active-route == "Audio"; activated => { root.active-route = "Audio"; } }
                    NavItem { label: "Analytics"; selected: root.active-route == "Analytics"; activated => { root.active-route = "Analytics"; } }
                    NavItem { label: "Knowledge"; selected: root.active-route == "Knowledge"; activated => { root.active-route = "Knowledge"; } }

                    Rectangle { height: 4px; background: transparent; }
                    Text { text: "GOVERNANCE"; color: Theme.ink-quiet; font-size: 11px; letter-spacing: 1.05px; }
                    NavItem { label: "Privacy"; selected: root.active-route == "Privacy"; activated => { root.active-route = "Privacy"; } }
                    NavItem { label: "Audit Trail"; selected: root.active-route == "Audit Trail"; activated => { root.active-route = "Audit Trail"; } }
                    NavItem { label: "Exports"; selected: root.active-route == "Exports"; activated => { root.active-route = "Exports"; } }
                    NavItem { label: "Integrations"; selected: root.active-route == "Integrations"; activated => { root.active-route = "Integrations"; } }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    Rectangle {
                        height: 64px;
                        border-radius: Theme.radius-compact;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface-raised;
                        accessible-role: text;
                        accessible-label: "Runtime status: local-first, network default deny, model runtime state visible in Model Center";
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 2px;
                            Text { text: "LOCAL RUNTIME"; color: Theme.ink-quiet; font-size: 11px; letter-spacing: 1px; }
                            Text { text: "No default egress"; color: Theme.ink; font-size: 11px; font-weight: 650; }
                            Text { text: "v" + root.product-version; color: Theme.ink-quiet; font-size: 11px; }
                        }
                    }

                    NavItem { label: "Settings"; selected: root.active-route == "Settings"; activated => { root.active-route = "Settings"; } }
                    NavItem { label: "About"; selected: root.active-route == "About"; activated => { root.active-route = "About"; } }
                }
            }

            Rectangle { width: 1px; background: Theme.border; }

            VerticalLayout {
                spacing: 0px;

                topbar := Rectangle {
                    height: 64px;
                    background: Theme.surface;
                    border-width: 0px;

                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 14px;

                        SearchField {
                            horizontal-stretch: 1;
                            placeholder: "Patients · sources · evidence · commands";
                            accessible-name: "Global search";
                            accepted(text) => { root.ui-action("search:" + text); }
                        }

                        Rectangle {
                            width: 156px;
                            height: 40px;
                            border-radius: 10px;
                            background: Theme.surface-raised;
                            border-width: 1px;
                            border-color: Theme.border;
                            accessible-role: text;
                            accessible-label: "Model Fabric status. " + root.model-runtime-summary;
                            Text {
                                text: "Model Fabric · local";
                                color: Theme.ink-subtle;
                                font-size: 11px;
                                font-weight: 650;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        ToolbarAction { label: "Commands"; activated => { root.palette-open = true; } }

                        Rectangle {
                            width: 40px;
                            border-radius: 20px;
                            background: Theme.surface-raised;
                            border-width: 1px;
                            border-color: Theme.border;
                            Text { text: "JD"; color: Theme.ink-subtle; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 18px;

                        HorizontalLayout {
                            height: 78px;
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: root.active-route == "Home" ? "Clinical Workspace" : root.active-route == "Patients" ? root.patient-name : root.active-route; color: Theme.ink; font-size: 28px; font-weight: 720; letter-spacing: -0.4px; }
                                Text { text: root.active-route == "Home" ? "Trusted local clinical intelligence · evidence before authority" : root.active-route == "Patients" ? "Trusted longitudinal workspace · Synthetic demo" : root.active-route == "Insights" ? "Evidence-aware population view · Synthetic demo" : root.active-route == "Models" ? "Local model fabric · provenance, runtime and benchmark state" : root.active-route == "Evidence" ? "Pinned OpenMed evidence · measured claims only · limitations explicit" : root.active-route == "Workflows" ? "Review-first controlled-action studio · Synthetic demo" : root.active-route == "Tasks" ? "Derived outbox review queue · No second task authority" : root.active-route == "Messages" ? "Local review previews · No external transport claim" : root.active-route == "Documents" ? "Bounded document intake posture · Custody is not understanding" : root.active-route == "Projects" ? "Project and artifact organization · Core-backed references, never payload copies" : root.active-route == "Data" ? "Governed datasets · immutable snapshots, saved views and deterministic transforms" : root.active-route == "Collaboration" ? "Local-first rooms, threads and tasks · Core-backed, membership-gated" : root.active-route == "MedAgent" ? "Governed agent runs · bound context, typed tools, evidence-only proposals" : root.active-route == "Model Fleet" ? "Independent agent lanes on one task · factual comparison, never a ranking" : root.active-route == "Privacy" ? "Data classes, de-identification receipts and egress decisions · unclassified stays local" : root.active-route == "Browse" ? "Read-only https retrieval · allowlisted hosts, private networks refused, content is evidence only" : root.active-route == "Audio" ? "Local audio sources and transcript lineage · nothing leaves this device" : root.active-route == "Analytics" ? "Read-only SQL over exact snapshots · every run leaves a receipt" : root.active-route == "Knowledge" ? "Lexical search over exact source revisions · stale evidence is labelled, never served as current" : root.active-route == "Audit Trail" ? "Synthetic disclosure history · Core Host remains canonical" : root.active-route == "Exports" ? "Loss-aware FHIR support · No full conformance claim" : root.active-route == "Settings" ? "Doctor truth and evidence-gated readiness" : root.active-route == "Integrations" ? "Brokered integration posture · Default deny" : root.active-route == "About" ? "Native product and attribution details" : "Unrecognized route"; color: Theme.ink-subtle; font-size: 13px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            if root.active-route == "Home": Text {
                                text: "Evidence first · action second";
                                color: Theme.signal-strong;
                                font-size: 11px;
                                font-weight: 650;
                            }
                        }

                        if root.active-route == "Projects": VerticalLayout {
                            spacing: 14px;
                            HonestyPanel { title: "Project authority boundary"; body: "Projects reference canonical objects by identity · membership never copies payloads · every mutation is revision-guarded"; accent: Theme.success; }

                            Rectangle {
                                min-height: 150px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Create a project. " + root.project-status;
                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        Text { text: "NEW PROJECT"; color: Theme.signal-strong; font-size: 11px; font-weight: 650; letter-spacing: 1px; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: root.project-status; color: Theme.ink-quiet; font-size: 11px; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit {
                                            horizontal-stretch: 1;
                                            text <=> root.project-name-input;
                                            placeholder: "Project name (1-128 characters)";
                                            accessible-name: "New project name";
                                            accepted(text) => { root.project-name-input = text; root.ui-action("projects-create"); }
                                        }
                                        AdaptiveLineEdit {
                                            horizontal-stretch: 1;
                                            text <=> root.project-desc-input;
                                            placeholder: "Description (optional)";
                                            accessible-name: "New project description";
                                            accepted(text) => { root.project-desc-input = text; root.ui-action("projects-create"); }
                                        }
                                        ToolbarAction { label: "Create"; activated => { root.ui-action("projects-create"); } }
                                        ToolbarAction { label: "Refresh"; activated => { root.ui-action("projects-refresh"); } }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Projects"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text { text: "Core-backed session state"; color: Theme.ink-quiet; font-size: 11px; }
                            }

                            for item in root.project-rows: Rectangle {
                                min-height: 64px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: item.name + ", " + item.status + ", revision " + item.revision;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    VerticalLayout { width: 260px; alignment: center; spacing: 2px;
                                        Text { text: item.name; color: Theme.ink; font-size: 12px; font-weight: 680; wrap: word-wrap; }
                                        Text { text: item.id + " · rev " + item.revision; color: Theme.ink-quiet; font-size: 11px; }
                                    }
                                    Text { width: 80px; text: item.status; color: Theme.ink-subtle; font-size: 11px; font-weight: 650; }
                                    Text { horizontal-stretch: 1; text: "experiments " + item.experiments + " · refs " + item.refs + " · edges " + item.edges; color: Theme.ink-subtle; font-size: 11px; }
                                    QuickAction { width: 110px; title: "Open"; subtitle: "Detail"; glyph: ""; accent: Theme.signal; activated => { root.ui-action("projects-open:" + item.id); } }
                                }
                            }

                            if root.project-active-id != "": VerticalLayout {
                                spacing: 12px;
                                Rectangle {
                                    border-radius: Theme.radius-compact;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: groupbox;
                                    accessible-label: "Open project detail. " + root.project-detail-name;
                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout { horizontal-stretch: 1; spacing: 2px;
                                                Text { text: root.project-detail-name; color: Theme.ink; font-size: 16px; font-weight: 700; wrap: word-wrap; }
                                                Text { text: root.project-detail-meta; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                            }
                                            ToolbarAction { label: "Archive"; activated => { root.ui-action("projects-archive"); } }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            AdaptiveLineEdit {
                                                horizontal-stretch: 1;
                                                text <=> root.project-experiment-input;
                                                placeholder: "New experiment name";
                                                accessible-name: "New experiment name";
                                                accepted(text) => { root.project-experiment-input = text; root.ui-action("projects-exp-create"); }
                                            }
                                            ToolbarAction { label: "Add experiment"; activated => { root.ui-action("projects-exp-create"); } }
                                        }
                                    }
                                }

                                Text { text: "Experiments"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                for item in root.project-experiments: Rectangle {
                                    min-height: 52px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: text;
                                    accessible-label: item.name + ", " + item.status + ", revision " + item.revision;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 12px;
                                        Text { width: 260px; text: item.name; color: Theme.ink; font-size: 11px; font-weight: 650; }
                                        Text { width: 90px; text: item.status; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { horizontal-stretch: 1; text: item.id + " · rev " + item.revision; color: Theme.ink-quiet; font-size: 11px; }
                                    }
                                }

                                Text { text: "Artifact references"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                for item in root.project-refs: Rectangle {
                                    min-height: 52px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: text;
                                    accessible-label: item.kind + " reference " + item.object-id + ", " + item.resolution;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 12px;
                                        Text { width: 160px; text: item.kind; color: Theme.ink; font-size: 11px; font-weight: 650; }
                                        Text { horizontal-stretch: 1; text: item.object-id; color: Theme.ink-subtle; font-size: 11px; }
                                        StatusPill { label: item.resolution; accent: item.resolution == "current" ? Theme.success : item.resolution == "stale" || item.resolution == "missing" ? Theme.warning : Theme.danger; }
                                    }
                                }

                                Text { text: "Relationships"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                for item in root.project-edges: Rectangle {
                                    min-height: 52px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: text;
                                    accessible-label: item.subject + " " + item.predicate + " " + item.object;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 12px;
                                        Text { horizontal-stretch: 1; text: item.subject + "  " + item.predicate + "  " + item.object; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        Text { width: 70px; text: "rev " + item.revision; color: Theme.ink-quiet; font-size: 11px; horizontal-alignment: right; }
                                    }
                                }
                            }
                        }

                        if root.active-route == "Data": VerticalLayout {
                            spacing: 14px;
                            HonestyPanel { title: "Dataset authority boundary"; body: "Snapshots are immutable and content-addressed · views are projections, never copies · transforms create new snapshots with lineage"; accent: Theme.success; }

                            Rectangle {
                                min-height: 64px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Data sources. " + root.data-status;

                        }

                        if root.active-route == "MedAgent": VerticalLayout {
                            spacing: 14px;
                            HonestyPanel { title: "MedAgent authority boundary"; body: "A run may only read what its bound ContextManifest names · tool dispatch is refused before execution when ungranted · output is always an evidence-only AgentProposal, never a ClinicalAssertion or canonical effect"; accent: Theme.success; }

                            Rectangle {
                                min-height: 96px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Runs. " + root.medagent-status;

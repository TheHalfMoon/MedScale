                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: item.name + ", " + item.kind + ", " + item.health;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    VerticalLayout { width: 260px; alignment: center; spacing: 2px;
                                        Text { text: item.name; color: Theme.ink; font-size: 12px; font-weight: 680; wrap: word-wrap; }
                                        Text { text: item.id + " · rev " + item.revision; color: Theme.ink-quiet; font-size: 11px; }
                                    }
                                    Text { width: 130px; text: item.kind; color: Theme.ink-subtle; font-size: 11px; }
                                    StatusPill { label: item.health; accent: item.health == "healthy" ? Theme.success : item.health == "stale" || item.health == "schema_changed" ? Theme.warning : Theme.danger; }
                                    QuickAction { width: 110px; title: "Open"; subtitle: "Snapshots"; glyph: ""; accent: Theme.signal; activated => { root.ui-action("data-open:" + item.id); } }
                                }
                            }

                            if root.data-active-source != "": VerticalLayout {
                                spacing: 12px;
                                Text { text: "Snapshots"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                for item in root.data-snapshots: Rectangle {
                                    min-height: 52px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: text;
                                    accessible-label: "Snapshot " + item.id + ", " + item.rows + " rows";
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 12px;
                                        Text { width: 120px; text: item.id; color: Theme.ink; font-size: 11px; font-weight: 650; }
                                        Text { width: 90px; text: item.rows + " rows"; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { horizontal-stretch: 1; text: item.digest; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                        QuickAction { width: 110px; title: "Inspect"; subtitle: "Rows"; glyph: ""; accent: Theme.signal; activated => { root.ui-action("data-snapshot:" + item.id); } }
                                    }
                                }

                                if root.data-active-snapshot != "": VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Workbench"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                    Text { text: root.data-schema-line; color: Theme.signal-strong; font-size: 11px; font-weight: 650; wrap: word-wrap; }
                                    Text { text: root.data-detail; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    for item in root.data-rows: Rectangle {
                                        min-height: 40px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: Theme.surface;
                                        accessible-role: text;
                                        accessible-label: item.text;
                                        HorizontalLayout {
                                            padding-left: 10px;

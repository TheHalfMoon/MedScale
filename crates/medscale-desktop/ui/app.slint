                                    Text { text: "Current trusted posture is intentionally narrow. A file may be admitted to local custody without becoming a clinical fact or an understood document."; color: Theme.ink-subtle; font-size: 12px; wrap: word-wrap; }
                                    HonestyPanel { title: "Understanding"; body: "OCR/ASR remain bounded stubs unless separately qualified. No document-derived clinical interpretation is claimed."; accent: Theme.coral; }
                                    HonestyPanel { title: "Authority"; body: "Source custody, extraction evidence, and clinical authority remain separate. Review is required before any consequential use."; accent: Theme.pine; }
                                    QuickAction { title: "Open patient documents"; subtitle: "View the current synthetic subject boundary"; glyph: "→"; accent: Theme.blurple; activated => { root.patient-tab = "Documents"; root.active-route = "Patients"; } }
                                }
                            }
                        }

                        if root.active-route == "Home": VerticalLayout {
                            spacing: 18px;

                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "Quick actions"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    QuickAction { title: "Prepare care-plan review"; subtitle: "Review-first proposal boundary"; glyph: "✦"; accent: Theme.blurple; activated => { root.ui-action("care-plan"); } }
                                    QuickAction { title: "Summarize patient"; subtitle: "Evidence-linked brief"; glyph: "≡"; accent: Theme.pine; activated => { root.ui-action("summarize"); } }
                                    QuickAction { title: "Import data"; subtitle: "FHIR / permitted files"; glyph: "⇧"; accent: Theme.coral; activated => { root.ui-action("import"); } }
                                    QuickAction { title: "Open command palette"; subtitle: "Cmd/Ctrl + K"; glyph: "⌘"; accent: Theme.lavender; activated => { root.palette-open = true; } }
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    Text { text: "Operational snapshot"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: "Synthetic demo"; color: Theme.ink-quiet; font-size: 11px; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    MetricCard { label: "Active patients"; value: "248"; delta: "↑ 12% demo trend"; glyph: "◎"; accent: Theme.blurple; }
                                    MetricCard { label: "Notes created"; value: "36"; delta: "↑ 28% demo trend"; glyph: "▤"; accent: Theme.pine; }
                                    MetricCard { label: "Review cues"; value: "12"; delta: "Evidence-state demo"; glyph: "◇"; accent: Theme.coral; }
                                    MetricCard { label: "Time saved"; value: "3.2h"; delta: "↑ 41% demo trend"; glyph: "◴"; accent: Theme.blurple; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Rectangle {
                                    horizontal-stretch: 3;
                                    height: 310px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            Text { text: "Active patient queue"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            Text { text: "View all →"; color: Theme.blurple-ink; font-size: 11px; }
                                        }
                                        Text { text: "Synthetic evidence-review queue; not a clinical risk ranking"; color: Theme.ink-subtle; font-size: 11px; }
                                        Rectangle { height: 1px; background: Theme.border; }

                                        HorizontalLayout { height: 42px; spacing: 12px; Text { text: "Synthetic Subject A"; color: Theme.ink; font-size: 12px; font-weight: 650; vertical-alignment: center; } Text { text: "Condition evidence present"; color: Theme.ink-subtle; font-size: 11px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "Evidence review"; accent: Theme.coral; } }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        HorizontalLayout { height: 42px; spacing: 12px; Text { text: "Synthetic Subject B"; color: Theme.ink; font-size: 12px; font-weight: 650; vertical-alignment: center; } Text { text: "Coverage evidence unknown"; color: Theme.ink-subtle; font-size: 11px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "Coverage gap"; accent: Theme.amber; } }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        HorizontalLayout { height: 42px; spacing: 12px; Text { text: "Synthetic Subject C"; color: Theme.ink; font-size: 12px; font-weight: 650; vertical-alignment: center; } Text { text: "Observation evidence available"; color: Theme.ink-subtle; font-size: 11px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "New evidence"; accent: Theme.blurple; } }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        HorizontalLayout { height: 42px; spacing: 12px; Text { text: "Synthetic Subject D"; color: Theme.ink; font-size: 12px; font-weight: 650; vertical-alignment: center; } Text { text: "Conflicting evidence"; color: Theme.ink-subtle; font-size: 11px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "Unresolved"; accent: Theme.danger; } }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 2;
                                    height: 310px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            Text { text: "MedScale Assistant"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            StatusPill { label: "Local"; accent: Theme.pine; }
                                        }
                                        Rectangle {
                                            height: 86px;
                                            border-radius: 14px;
                                            background: Theme.blurple-soft;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 4px;
                                                Text { text: "How can I help today?"; color: Theme.ink; font-size: 14px; font-weight: 650; }
                                                Text { text: "Summarize, navigate, inspect evidence, or prepare a reviewable workflow."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                            }
                                        }
                                        QuickAction { title: "Summarize current patient"; subtitle: "Source-aware brief"; glyph: "≡"; accent: Theme.blurple; activated => { root.ui-action("summarize"); } }
                                        QuickAction { title: "Inspect privacy status"; subtitle: "Doctor + evidence posture"; glyph: "✓"; accent: Theme.pine; activated => { root.ui-action("privacy-status"); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.palette-open: Rectangle {
        x: parent.width / 2 - 270px;
        y: 104px;
        width: 540px;
        height: 338px;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        accessible-role: groupbox;
        accessible-label: "MedScale command palette";
        drop-shadow-blur: 28px;
        drop-shadow-color: #15182B22;
        drop-shadow-offset-y: 10px;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            Text { text: "Command palette"; color: Theme.ink; font-size: 16px; font-weight: 700; }
            palette-search := LineEdit { placeholder-text: "Search commands…"; accessible-label: "Command palette search"; }
            QuickAction { title: "Go to Patients"; subtitle: "Open patient workspace"; glyph: "○"; accent: Theme.blurple; activated => { root.active-route = "Patients"; root.palette-open = false; } }
            QuickAction { title: "Open Insights"; subtitle: "Evidence-aware population view"; glyph: "▥"; accent: Theme.pine; activated => { root.active-route = "Insights"; root.palette-open = false; } }
            QuickAction { title: "Open Workflows"; subtitle: "Automation studio"; glyph: "⌘"; accent: Theme.coral; activated => { root.active-route = "Workflows"; root.palette-open = false; } }
        }
    }
}

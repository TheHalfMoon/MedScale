                                        spacing: 8px;
                                        Text { horizontal-stretch: 1; text: "Sources and captures follow the active project"; color: Theme.ink; font-size: 12px; font-weight: 680; }
                                        ToolbarAction { label: "Refresh"; activated => { root.ui-action("audio-refresh"); } }
                                    }
                                    Text { text: root.audio-status; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    if root.audio-native-capture != "": Text { text: root.audio-native-capture; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; accessible-role: text; accessible-label: root.audio-native-capture; }
                                    if root.audio-last-result != "": Text { text: root.audio-last-result; color: Theme.ink; font-size: 11px; wrap: word-wrap; accessible-role: text; accessible-label: "Last segmentation: " + root.audio-last-result; }
                                    if root.audio-transcript != "": Text { text: root.audio-transcript; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; accessible-role: text; accessible-label: "Transcript segments: " + root.audio-transcript; }
                                }
                            }

                            Text { text: "Capture sessions (newest first)"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.audio-captures: Rectangle {
                                min-height: 40px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: text;
                                accessible-label: "Capture " + item.label + ", " + item.state + ", " + item.detail;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; vertical-alignment: center; text: item.label + " · " + item.detail; color: Theme.ink; font-size: 12px; wrap: word-wrap; }
                                    StatusPill { label: item.state; accent: item.state == "recording" ? Theme.danger : item.state == "stopped" ? Theme.success : Theme.warning; }
                                }

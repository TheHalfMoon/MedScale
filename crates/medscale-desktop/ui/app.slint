                                                spacing: 8px;
                                                QuickAction { title: "Explain gaps"; subtitle: "Evidence state only"; glyph: "?"; accent: Theme.warning; activated => { root.ui-action("insights-assistant:Explain coverage gaps"); } }
                                                QuickAction { title: "Risk limits"; subtitle: "No clinical ranking"; glyph: "!"; accent: Theme.warning; activated => { root.ui-action("insights-assistant:Who is highest risk?"); } }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 16px;
                                    HonestyPanel { horizontal-stretch: 1; title: "Risk distribution boundary"; body: root.insights-risk-state; accent: Theme.warning; }
                                    HonestyPanel { horizontal-stretch: 1; title: "Trend boundary"; body: root.insights-trend-state; accent: Theme.signal; }
                                }
                                HorizontalLayout {

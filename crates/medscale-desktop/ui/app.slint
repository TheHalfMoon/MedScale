                                            Text { horizontal-stretch: 1; text: item.label; color: Theme.ink; font-size: 11px; font-weight: 650; vertical-alignment: center; }
                                            Text { width: 46px; text: item.value; color: Theme.blurple-ink; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-alignment: right; }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 3;

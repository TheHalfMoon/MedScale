                                    Rectangle { height: 12px; background: transparent; }
                                    HorizontalLayout { height: 38px; spacing: 12px;
                                        Text { width: 160px; text: "SUBJECT"; color: Theme.ink-quiet; font-size: 11px; font-weight: 700; }
                                        Text { width: 210px; text: "CONDITION"; color: Theme.ink-quiet; font-size: 11px; font-weight: 700; }
                                        Text { horizontal-stretch: 1; text: "EVIDENCE STATE"; color: Theme.ink-quiet; font-size: 11px; font-weight: 700; }

                                                StatusPill { label: "Evidence context"; accent: Theme.success; }
                                            }
                                            Text { text: "Deterministic local UX — no provider/model authority in this slice."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                            assistant-query := AdaptiveLineEdit {
                                                placeholder: "Ask about coverage, cohorts, evidence, or risk limits…";

                                            }
                                            Text { width: 90px; text: item.state; color: Theme.ink-subtle; font-size: 10px; font-weight: 650; vertical-alignment: center; }
                                            VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                                Text { text: item.next-step; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                                Text { text: "Payload digest: " + item.payload-digest; color: Theme.ink-quiet; font-size: 8px; }
                                            }
                                            QuickAction { width: 130px; title: "Inspect"; subtitle: "No commit"; glyph: "→"; accent: item.reconcile-required ? Theme.coral : Theme.blurple; activated => { root.ui-action("workflow-review:" + item.action-id); } }
                                        }
                                    }
                                }
                            }
                            HonestyPanel { title: "Selected review detail"; body: root.workflow-review-detail; accent: Theme.pine; }

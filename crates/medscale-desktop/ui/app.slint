                                            Text { width: 210px; text: item.condition; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; vertical-alignment: center; }
                                            Text { horizontal-stretch: 1; text: item.evidence-state; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; vertical-alignment: center; }
                                            Text { width: 150px; text: item.review-attention; color: Theme.ink-subtle; font-size: 9px; vertical-alignment: center; horizontal-alignment: right; }
                                        }
                                    }

                                        height: 58px;
                                        background: Theme.surface;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        accessible-role: text;
                                        accessible-label: item.name + ", " + item.condition + ", " + item.evidence-state + ", " + item.review-attention;
                                        HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 12px;
                                            VerticalLayout { width: 160px; alignment: center; spacing: 1px;
                                                Text { text: item.name; color: Theme.ink; font-size: 11px; font-weight: 650; }
                                                Text { text: item.subject-ref; color: Theme.ink-quiet; font-size: 8px; }
                                            }
                                            Text { width: 210px; text: item.condition; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                            Text { horizontal-stretch: 1; text: item.evidence-state; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                            Text { width: 150px; text: item.review-attention; color: Theme.ink-subtle; font-size: 9px; horizontal-alignment: right; }
                                        }
                                    }
                                }
                            }

                            if root.insights-tab == "Evidence": HorizontalLayout {
                                spacing: 16px;
                                Rectangle {
                                    horizontal-stretch: 2;
                                    min-height: 390px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;
                                        Text { text: "Present condition distribution"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                        Text { text: "Only Present condition facts are counted. Conflict/unknown values are not promoted into the distribution."; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        for item in root.insights-conditions: HorizontalLayout {
                                            height: 44px;
                                            accessible-role: text;
                                            accessible-label: item.label + ": " + item.value + ". " + item.detail;
                                            Text { horizontal-stretch: 1; text: item.label; color: Theme.ink; font-size: 11px; font-weight: 650; }
                                            Text { width: 46px; text: item.value; color: Theme.signal-strong; font-size: 15px; font-weight: 700; horizontal-alignment: right; }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 3;
                                    min-height: 390px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: groupbox;
                                    accessible-label: "Evidence retrieval cards; relevance is not authority";
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;
                                        Text { text: "Assistant evidence context"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                        Text { text: "Retracted, freshness, conflict, corpus identity, and relevance-only metadata remain visible."; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                        for item in root.insights-evidence: Rectangle {
                                            min-height: 104px;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            background: Theme.surface-raised;
                                            accessible-role: text;
                                            accessible-label: item.title + ". " + item.metadata + ". " + item.snippet;
                                            VerticalLayout {
                                                padding: 12px;
                                                spacing: 4px;
                                                HorizontalLayout {
                                                    Text { text: item.title; color: Theme.ink; font-size: 11px; font-weight: 650; }
                                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                                    Text { text: item.source; color: Theme.signal-strong; font-size: 9px; }
                                                }
                                                Text { text: item.snippet; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                                Text { text: item.metadata; color: Theme.ink-quiet; font-size: 9px; wrap: word-wrap; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.active-route == "Workflows": VerticalLayout {
                            spacing: 18px;
                            HorizontalLayout {
                                spacing: 12px;
                                MetricCard { label: "Studio posture"; value: "Review first"; delta: "No Desktop commit"; glyph: "⌘"; accent: Theme.signal; }
                                MetricCard { label: "Outbox state"; value: "5 demo"; delta: root.workflow-outbox-summary; glyph: "⇥"; accent: Theme.success; }
                                MetricCard { label: "UNKNOWN policy"; value: "Reconcile"; delta: "Blind retry forbidden"; glyph: "!"; accent: Theme.warning; }
                                MetricCard { label: "Payload identity"; value: "SHA-256"; delta: "Bound before send"; glyph: "#"; accent: Theme.warning; }
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                Rectangle {
                                    horizontal-stretch: 3;
                                    min-height: 420px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: groupbox;
                                    accessible-label: "Review-first workflow graph. Core Host owns controlled actions.";
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;
                                        Text { text: root.workflow-name; color: Theme.ink; font-size: 16px; font-weight: 700; }
                                        Text { text: root.workflow-state; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        for item in root.workflow-steps: Rectangle {
                                            min-height: 66px;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            background: Theme.surface-raised;
                                            accessible-role: text;
                                            accessible-label: "Step " + item.order + ", " + item.title + ", " + item.state + ". " + item.detail;
                                            HorizontalLayout {
                                                padding: 12px;
                                                spacing: 12px;
                                                Rectangle {
                                                    width: 38px;
                                                    height: 38px;
                                                    border-radius: 10px;
                                                    background: Theme.signal-soft;
                                                    Text { text: item.order; color: Theme.signal-strong; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 3px;
                                                    Text { text: item.title; color: Theme.ink; font-size: 12px; font-weight: 650; }
                                                    Text { text: item.detail; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                                }
                                                StatusPill { label: item.state; accent: item.state == "Fail closed" ? Theme.warning : item.state == "Required" ? Theme.warning : Theme.success; }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 2;
                                    spacing: 12px;
                                    HonestyPanel { title: "Authority boundary"; body: root.workflow-action-boundary; accent: Theme.success; }
                                    HonestyPanel { title: "Task semantics"; body: root.workflow-task-boundary; accent: Theme.signal; }
                                    QuickAction { title: "Open review tasks"; subtitle: "Derived from durable outbox state"; glyph: "✓"; accent: Theme.signal; activated => { root.active-route = "Tasks"; } }
                                    QuickAction { title: "Open message previews"; subtitle: "No external send from this UI"; glyph: "✉"; accent: Theme.success; activated => { root.active-route = "Messages"; } }
                                }
                            }
                        }

                        if root.active-route == "Tasks": VerticalLayout {
                            spacing: 16px;
                            HonestyPanel { title: "Derived review queue"; body: root.workflow-task-boundary; accent: Theme.signal; }
                            Rectangle {
                                min-height: 390px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Review tasks derived from durable controlled-action outbox entries";
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 0px;
                                    HorizontalLayout { height: 38px; spacing: 12px;
                                        Text { width: 190px; text: "REVIEW ITEM"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; }
                                        Text { width: 90px; text: "STATE"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; }
                                        Text { horizontal-stretch: 1; text: "NEXT SAFE STEP"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; }
                                        Text { width: 130px; text: "ACTION"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; horizontal-alignment: right; }
                                    }
                                    for item in root.workflow-tasks: Rectangle {
                                        min-height: 74px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: Theme.surface;
                                        accessible-role: groupbox;
                                        accessible-label: item.title + ", " + item.state + ". " + item.next-step;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 12px;
                                            VerticalLayout { width: 190px; alignment: center; spacing: 2px;
                                                Text { text: item.title; color: Theme.ink; font-size: 11px; font-weight: 650; wrap: word-wrap; }
                                                Text { text: item.action-id; color: Theme.ink-quiet; font-size: 8px; }
                                            }
                                            Text { width: 90px; text: item.state; color: Theme.ink-subtle; font-size: 10px; font-weight: 650; }
                                            VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                                Text { text: item.next-step; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                                Text { text: "Payload digest: " + item.payload-digest; color: Theme.ink-quiet; font-size: 8px; }
                                            }
                                            QuickAction { width: 130px; title: "Inspect"; subtitle: "No commit"; glyph: "→"; accent: item.reconcile-required ? Theme.warning : Theme.signal; activated => { root.ui-action("workflow-review:" + item.action-id); } }
                                        }
                                    }
                                }
                            }
                            HonestyPanel { title: "Selected review detail"; body: root.workflow-review-detail; accent: Theme.success; }
                        }

                        if root.active-route == "Messages": VerticalLayout {
                            spacing: 16px;
                            HonestyPanel { title: "Message boundary"; body: root.workflow-message-boundary; accent: Theme.success; }
                            Rectangle {
                                min-height: 420px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Local review message previews; no external messaging transport";
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    for item in root.workflow-messages: Rectangle {
                                        min-height: 72px;
                                        border-radius: 12px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: Theme.surface-raised;
                                        accessible-role: text;
                                        accessible-label: item.title + ", " + item.status + ". " + item.body;
                                        HorizontalLayout {
                                            padding: 12px;
                                            spacing: 12px;
                                            VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                                                Text { text: item.title; color: Theme.ink; font-size: 11px; font-weight: 650; }
                                                Text { text: item.body; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                                Text { text: "Related action: " + item.related-action-id; color: Theme.ink-quiet; font-size: 8px; }
                                            }
                                            StatusPill { label: item.status; accent: item.status == "Reconcile first" ? Theme.warning : item.status == "Review required" ? Theme.warning : Theme.success; }
                                        }
                                    }
                                }
                            }
                        }

                        if root.active-route == "Audit Trail": VerticalLayout {
                            spacing: 16px;
                            HonestyPanel { title: "Audit authority boundary"; body: root.utility-audit-boundary; accent: Theme.success; }
                            Rectangle {
                                min-height: 420px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Synthetic disclosure audit history";
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 0px;
                                    HorizontalLayout { height: 38px; spacing: 12px;
                                        Text { width: 185px; text: "DISCLOSURE"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; }
                                        Text { width: 170px; text: "PURPOSE"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; }
                                        Text { width: 210px; text: "SUBJECT"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; }
                                        Text { horizontal-stretch: 1; text: "DETAIL"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; }
                                        Text { width: 150px; text: "STATUS"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; horizontal-alignment: right; }
                                    }
                                    for item in root.utility-audit-rows: Rectangle {
                                        min-height: 64px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: Theme.surface;
                                        accessible-role: text;
                                        accessible-label: item.action + ", " + item.subject + ", " + item.status + ". " + item.detail;
                                        HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 12px;
                                            Text { width: 185px; text: item.record-id; color: Theme.signal-strong; font-size: 9px; }
                                            Text { width: 170px; text: item.action; color: Theme.ink; font-size: 10px; font-weight: 650; wrap: word-wrap; }
                                            Text { width: 210px; text: item.subject; color: Theme.ink-subtle; font-size: 9px; wrap: word-wrap; }
                                            Text { horizontal-stretch: 1; text: item.detail; color: Theme.ink-subtle; font-size: 9px; wrap: word-wrap; }
                                            Text { width: 150px; text: item.status; color: Theme.ink-subtle; font-size: 9px; wrap: word-wrap; horizontal-alignment: right; }
                                        }
                                    }
                                }
                            }
                        }

                        if root.active-route == "Exports": VerticalLayout {
                            spacing: 16px;
                            HonestyPanel { title: "FHIR export boundary"; body: root.utility-export-boundary; accent: Theme.signal; }
                            Rectangle {
                                min-height: 390px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "FHIR R4 support matrix for loss-aware export";
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text { text: "FHIR R4 support matrix"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                    Text { text: "Support is axis-specific. Unsupported clinical interpretation is kept explicit."; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                    for item in root.utility-export-rows: Rectangle {
                                        min-height: 76px;
                                        border-radius: 12px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: Theme.surface-raised;
                                        accessible-role: text;
                                        accessible-label: item.label + ", " + item.value + ", " + item.status + ". " + item.detail;
                                        HorizontalLayout { padding: 12px; spacing: 12px;
                                            Text { width: 130px; text: item.label; color: Theme.ink; font-size: 12px; font-weight: 700; }
                                            VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                                                Text { text: item.value; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                                Text { text: item.detail; color: Theme.ink-quiet; font-size: 9px; wrap: word-wrap; }
                                            }
                                            StatusPill { label: item.status; accent: Theme.warning; }
                                        }
                                    }
                                }
                            }
                        }

                        if root.active-route == "Settings": VerticalLayout {
                            spacing: 16px;
                            HonestyPanel { title: "Settings are not evidence"; body: root.utility-settings-boundary; accent: Theme.success; }
                            Rectangle {
                                min-height: 390px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Doctor-backed product settings and readiness status";
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    for item in root.utility-settings-rows: Rectangle {
                                        min-height: 72px;
                                        border-radius: 12px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: Theme.surface-raised;
                                        accessible-role: text;
                                        accessible-label: item.label + ", " + item.value + ", " + item.status + ". " + item.detail;
                                        HorizontalLayout { padding: 12px; spacing: 12px;
                                            VerticalLayout { width: 210px; alignment: center; spacing: 2px;
                                                Text { text: item.label; color: Theme.ink; font-size: 11px; font-weight: 650; }
                                                Text { text: item.value; color: Theme.signal-strong; font-size: 10px; font-weight: 650; }
                                            }
                                            Text { horizontal-stretch: 1; text: item.detail; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                            StatusPill { label: item.status; accent: item.status == "Fail closed" ? Theme.warning : Theme.warning; }
                                        }
                                    }
                                }
                            }
                            HonestyPanel { title: "Missing release evidence"; body: root.utility-missing-release-evidence; accent: Theme.warning; }
                        }

                        if root.active-route == "Integrations": VerticalLayout {
                            spacing: 16px;
                            HonestyPanel { title: "Integration boundary"; body: root.utility-integrations-boundary; accent: Theme.success; }
                            Rectangle {
                                min-height: 420px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Integration readiness and default-deny status";
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    for item in root.utility-integration-rows: Rectangle {
                                        min-height: 76px;
                                        border-radius: 12px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: Theme.surface-raised;
                                        accessible-role: text;
                                        accessible-label: item.label + ", " + item.value + ", " + item.status + ". " + item.detail;
                                        HorizontalLayout { padding: 12px; spacing: 12px;
                                            VerticalLayout { width: 170px; alignment: center; spacing: 2px;
                                                Text { text: item.label; color: Theme.ink; font-size: 12px; font-weight: 650; }
                                                Text { text: item.value; color: Theme.signal-strong; font-size: 10px; font-weight: 650; }
                                            }
                                            Text { horizontal-stretch: 1; text: item.detail; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                            StatusPill { label: item.status; accent: item.status == "Untouched" ? Theme.ink-quiet : item.status == "Not live" ? Theme.warning : Theme.success; }
                                        }
                                    }
                                }
                            }
                        }

                        if root.active-route == "Documents": VerticalLayout {
                            spacing: 18px;
                            HonestyPanel {
                                title: "Documents — bounded intake";
                                body: root.patient-documents-state;
                                accent: Theme.signal;
                            }
                            Rectangle {
                                min-height: 280px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Document intake boundary. Accepted custody does not imply OCR, semantic understanding, or clinical authority.";
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 12px;
                                    Text { text: "Document intake boundary"; color: Theme.ink; font-size: 16px; font-weight: 700; }
                                    Text { text: "Current trusted posture is intentionally narrow. A file may be admitted to local custody without becoming a clinical fact or an understood document."; color: Theme.ink-subtle; font-size: 12px; wrap: word-wrap; }
                                    HonestyPanel { title: "Understanding"; body: "OCR/ASR remain bounded stubs unless separately qualified. No document-derived clinical interpretation is claimed."; accent: Theme.warning; }
                                    HonestyPanel { title: "Authority"; body: "Source custody, extraction evidence, and clinical authority remain separate. Review is required before any consequential use."; accent: Theme.success; }
                                    QuickAction { title: "Open patient documents"; subtitle: "View the current synthetic subject boundary"; glyph: "→"; accent: Theme.signal; activated => { root.patient-tab = "Documents"; root.active-route = "Patients"; } }
                                }
                            }
                        }

                        if root.active-route == "Home": VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                spacing: 16px;

                                Rectangle {
                                    horizontal-stretch: 3;
                                    min-height: 210px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: groupbox;
                                    accessible-label: "Current clinical workspace for Synthetic Subject A";
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 9px;
                                        Text { text: "CURRENT CLINICAL WORKSPACE"; color: Theme.ink-quiet; font-size: 9px; letter-spacing: 1.1px; }
                                        Text { text: "Synthetic Subject A"; color: Theme.ink; font-size: 24px; font-weight: 720; letter-spacing: -0.3px; }
                                        Text { text: "Condition evidence present · coverage unknown · one conflicting source requires review"; color: Theme.ink-subtle; font-size: 12px; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        HorizontalLayout {
                                            spacing: 18px;
                                            VerticalLayout { spacing: 2px; Text { text: "SOURCE TRAIL"; color: Theme.ink-quiet; font-size: 8px; letter-spacing: 1px; } Text { text: "3 admitted sources"; color: Theme.ink; font-size: 11px; font-weight: 650; } }
                                            VerticalLayout { spacing: 2px; Text { text: "IDENTITY"; color: Theme.ink-quiet; font-size: 8px; letter-spacing: 1px; } Text { text: "No silent merge"; color: Theme.ink; font-size: 11px; font-weight: 650; } }
                                            VerticalLayout { spacing: 2px; Text { text: "AUTHORITY"; color: Theme.ink-quiet; font-size: 8px; letter-spacing: 1px; } Text { text: "Core Host"; color: Theme.ink; font-size: 11px; font-weight: 650; } }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                        HorizontalLayout {
                                            spacing: 10px;
                                            QuickAction { title: "Open patient record"; subtitle: "Timeline, coverage, sources"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Patients"; } }
                                            QuickAction { title: "Review evidence"; subtitle: "Trace claims to sources"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Evidence"; } }
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 2;
                                    min-height: 210px;
                                    border-radius: 16px;
                                    background: Theme.obsidian;
                                    accessible-role: groupbox;
                                    accessible-label: "Inspectable AI layer. " + root.model-runtime-summary;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 9px;
                                        HorizontalLayout {
                                            Text { text: "AI LAYER"; color: Theme.nav-subtle; font-size: 9px; letter-spacing: 1.1px; }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            StatusPill { label: "INSPECTABLE"; accent: Theme.signal; }
                                        }
                                        Text { text: "AI is visible, not implied."; color: Theme.nav-text; font-size: 18px; font-weight: 700; }
                                        Text { text: root.model-runtime-summary; color: Theme.nav-subtle; font-size: 11px; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: Theme.graphite-raised; }
                                        Text { text: "HF source ≠ runtime authority. Every model must carry task, digest, rights, device and benchmark evidence."; color: Theme.nav-subtle; font-size: 10px; wrap: word-wrap; }
                                        QuickAction { title: "Inspect Model Center"; subtitle: "Runtime · source · trust · benchmark"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Models"; } }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "Clinical flow"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                Rectangle {
                                    min-height: 132px;
                                    border-radius: 14px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: groupbox;
                                    accessible-label: "Clinical flow: prepare, understand, act";
                                    HorizontalLayout {
                                        padding: 18px;
                                        spacing: 18px;
                                        VerticalLayout {
                                            horizontal-stretch: 1; spacing: 5px;
                                            Text { text: "01  PREPARE"; color: Theme.signal-strong; font-size: 9px; font-weight: 700; letter-spacing: 0.9px; }
                                            Text { text: "Know the record before the encounter"; color: Theme.ink; font-size: 13px; font-weight: 650; wrap: word-wrap; }
                                            Text { text: "Surface longitudinal context, source freshness, conflicts and coverage before work begins."; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                        }
                                        Rectangle { width: 1px; background: Theme.border; }
                                        VerticalLayout {
                                            horizontal-stretch: 1; spacing: 5px;
                                            Text { text: "02  UNDERSTAND"; color: Theme.signal-strong; font-size: 9px; font-weight: 700; letter-spacing: 0.9px; }
                                            Text { text: "Keep intelligence tied to evidence"; color: Theme.ink; font-size: 13px; font-weight: 650; wrap: word-wrap; }
                                            Text { text: "Assistant and model outputs remain inspectable proposals with source links and explicit limits."; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                        }
                                        Rectangle { width: 1px; background: Theme.border; }
                                        VerticalLayout {
                                            horizontal-stretch: 1; spacing: 5px;
                                            Text { text: "03  ACT"; color: Theme.signal-strong; font-size: 9px; font-weight: 700; letter-spacing: 0.9px; }
                                            Text { text: "Review before anything consequential"; color: Theme.ink; font-size: 13px; font-weight: 650; wrap: word-wrap; }
                                            Text { text: "Controlled actions bind payload identity, durable outbox state and UNKNOWN reconciliation."; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                min-height: 286px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 9px;
                                    HorizontalLayout {
                                        Text { text: "Review queue"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: "Synthetic demo · not a clinical risk ranking"; color: Theme.ink-quiet; font-size: 9px; }
                                    }
                                    Rectangle { height: 1px; background: Theme.border; }
                                    HorizontalLayout { height: 44px; spacing: 12px; Text { width: 180px; text: "Synthetic Subject A"; color: Theme.ink; font-size: 11px; font-weight: 650; } Text { text: "Condition evidence present"; color: Theme.ink-subtle; font-size: 10px; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "Evidence review"; accent: Theme.warning; } }
                                    Rectangle { height: 1px; background: Theme.border; }
                                    HorizontalLayout { height: 44px; spacing: 12px; Text { width: 180px; text: "Synthetic Subject B"; color: Theme.ink; font-size: 11px; font-weight: 650; } Text { text: "Coverage evidence unknown"; color: Theme.ink-subtle; font-size: 10px; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "Coverage gap"; accent: Theme.warning; } }
                                    Rectangle { height: 1px; background: Theme.border; }
                                    HorizontalLayout { height: 44px; spacing: 12px; Text { width: 180px; text: "Synthetic Subject C"; color: Theme.ink; font-size: 11px; font-weight: 650; } Text { text: "Observation evidence available"; color: Theme.ink-subtle; font-size: 10px; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "New evidence"; accent: Theme.signal; } }
                                    Rectangle { height: 1px; background: Theme.border; }
                                    HorizontalLayout { height: 44px; spacing: 12px; Text { width: 180px; text: "Synthetic Subject D"; color: Theme.ink; font-size: 11px; font-weight: 650; } Text { text: "Conflicting evidence"; color: Theme.ink-subtle; font-size: 10px; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "Unresolved"; accent: Theme.danger; } }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        QuickAction { title: "Open all patients"; subtitle: "Longitudinal workspace"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Patients"; } }
                                        QuickAction { title: "Open proof ledger"; subtitle: "Inspect pinned OpenMed claim states"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Evidence"; } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.palette-open: Rectangle {
        x: parent.width / 2 - 270px;
        y: 104px;
        width: 540px;
        height: 338px;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        accessible-role: groupbox;
        accessible-label: "MedScale command palette";
        drop-shadow-blur: 28px;
        drop-shadow-color: #15182B22;
        drop-shadow-offset-y: 10px;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            Text { text: "Command palette"; color: Theme.ink; font-size: 16px; font-weight: 700; }
            palette-search := LineEdit { placeholder-text: "Search commands…"; accessible-label: "Command palette search"; }
            QuickAction { title: "Go to Patients"; subtitle: "Open patient workspace"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Patients"; root.palette-open = false; } }
            QuickAction { title: "Open Models"; subtitle: "Inspect local model/runtime truth"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Models"; root.palette-open = false; } }
            QuickAction { title: "Open Evidence"; subtitle: "MedScale × OpenMed proof ledger"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Evidence"; root.palette-open = false; } }
        }
    }
}

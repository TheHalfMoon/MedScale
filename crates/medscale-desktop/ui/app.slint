                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: text;
                                accessible-label: "Receipt " + item.id + ", " + item.outcome + ", " + item.detail;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; vertical-alignment: center; text: item.id + " · " + item.detail; color: Theme.ink; font-size: 12px; wrap: word-wrap; }
                                    StatusPill { label: item.outcome; accent: item.outcome == "completed" ? Theme.success : item.outcome == "truncated" ? Theme.warning : Theme.danger; }
                                }
                            }
                        }

                        if root.active-route == "Audio": VerticalLayout {
                            spacing: 14px;
                            HonestyPanel { title: "AudioFlow boundary"; body: "Audio stays on this device and no cloud speech route exists · capture only starts on an explicit request and its state is always shown · source audio is never changed; transcripts are separate revisions · automatic text is not clinical truth and speakers are never identified · no speech recognition engine is installed in this build"; accent: Theme.success; }

                            Rectangle {
                                min-height: 96px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "AudioFlow. " + root.audio-status;
                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 6px;

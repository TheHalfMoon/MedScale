import { AboutSlint, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { HonestyPanel, NavItem, QuickAction, SegmentTab, ToolbarAction, MetricCard, StatusPill } from "components.slint";

export struct PatientTimelineItem {
    date: string,
    title: string,
    detail: string,
    source: string,
    status: string,
}

export struct PatientLabItem {
    label: string,
    value: string,
    unit: string,
    status: string,
    source: string,
}

export struct PatientSourceItem {
    source-id: string,
    note: string,
}

export struct PopulationDistributionItem {
    label: string,
    value: string,
    detail: string,
    status: string,
}

export struct PopulationCohortItem {
    name: string,
    subject-ref: string,
    condition: string,
    evidence-state: string,
    review-attention: string,
}

export struct AssistantEvidenceItem {
    source: string,
    title: string,
    snippet: string,
    metadata: string,
}

export struct WorkflowStepItem {
    order: string,
    title: string,
    detail: string,
    state: string,
}

export struct WorkflowTaskItem {
    action-id: string,
    title: string,
    state: string,
    payload-digest: string,
    next-step: string,
    reconcile-required: bool,
}

export struct WorkflowMessageItem {
    title: string,
    body: string,
    status: string,
    related-action-id: string,
}

export struct UtilityStatusItem {
    label: string,
    value: string,
    detail: string,
    status: string,
}

export struct AuditTrailItem {
    record-id: string,
    action: string,
    subject: string,
    detail: string,
    status: string,
}

export struct ModelStatusItem {
    scope: string,
    task: string,
    model: string,
    source: string,
    runtime: string,
    device: string,
    trust: string,
    benchmark: string,
    digest: string,
    state: string,
}

export struct CompetitiveEvidenceItem {
    capability: string,
    medscale: string,
    openmed: string,
    verdict: string,
    evidence: string,
    limitations: string,
}

export component AppWindow inherits Window {
    title: "MedScale";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1100px;
    min-height: 720px;
    background: Theme.canvas;
    default-font-family: "Geist";
    default-font-size: 14px;

    in-out property <string> active-route: "Home";
    in-out property <bool> palette-open: false;
    in-out property <string> patient-tab: "Overview";
    in property <string> product-version: "0.1.0";
    in property <string> patient-name: "Synthetic subject";
    in property <string> patient-subject-ref: "synthetic-subject";
    in property <string> patient-birth-date: "Unknown — not inferred";
    in property <string> patient-condition-summary: "No supported condition facts in this projection";
    in property <string> patient-coverage-summary: "No coverage summary";
    in property <string> patient-coverage-state: "Unknown";
    in property <[PatientTimelineItem]> patient-timeline;
    in property <[PatientLabItem]> patient-labs;
    in property <[PatientSourceItem]> patient-sources;
    in property <string> patient-medications-state;
    in property <string> patient-documents-state;
    in property <string> patient-care-plan-state;
    in-out property <string> insights-tab: "Overview";
    in property <string> insights-cohort-size: "0";
    in property <string> insights-review-attention: "0";
    in property <string> insights-evidence-gaps: "0";
    in property <string> insights-present-count: "0";
    in property <[PopulationDistributionItem]> insights-conditions;
    in property <[PopulationDistributionItem]> insights-coverage;
    in property <[PopulationCohortItem]> insights-cohorts;
    in property <[AssistantEvidenceItem]> insights-evidence;
    in property <string> insights-risk-state;
    in property <string> insights-trend-state;
    in property <string> insights-gap-state;
    in property <string> insights-recommendation-state;
    in-out property <string> insights-assistant-answer;
    in property <string> workflow-name;
    in property <string> workflow-state;
    in property <string> workflow-outbox-summary;
    in property <string> workflow-action-boundary;
    in property <string> workflow-task-boundary;
    in property <string> workflow-message-boundary;
    in-out property <string> workflow-review-detail;
    in property <[WorkflowStepItem]> workflow-steps;
    in property <[WorkflowTaskItem]> workflow-tasks;
    in property <[WorkflowMessageItem]> workflow-messages;
    in property <string> utility-audit-boundary;
    in property <string> utility-export-boundary;
    in property <string> utility-settings-boundary;
    in property <string> utility-integrations-boundary;
    in property <string> utility-missing-release-evidence;
    in property <[AuditTrailItem]> utility-audit-rows;
    in property <[UtilityStatusItem]> utility-export-rows;
    in property <[UtilityStatusItem]> utility-settings-rows;
    in property <[UtilityStatusItem]> utility-integration-rows;
    in property <string> model-runtime-summary;
    in property <string> model-runtime-boundary;
    in property <string> model-source-summary;
    in property <string> model-inventory-summary;
    in-out property <string> model-pack-path: "";
    in property <string> model-operator-status: "Ready for local Pack inspection";
    in property <string> openmed-baseline;
    in property <string> competitive-summary;
    in property <[ModelStatusItem]> model-rows;
    in property <[CompetitiveEvidenceItem]> competitive-evidence-rows;
    callback ui-action(string);

    forward-focus: global-keys;

    global-keys := FocusScope {
        key-pressed(event) => {
            if ((event.modifiers.control || event.modifiers.meta) && (event.text == "k" || event.text == "K")) {
                root.palette-open = !root.palette-open;
                return accept;
            }
            if (event.text == Key.Escape) {
                root.palette-open = false;
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            spacing: 0px;

            sidebar := Rectangle {
                width: 232px;
                background: Theme.obsidian;
                border-width: 0px;

                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 18px;
                    padding-bottom: 18px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 54px;
                        spacing: 11px;
                        Image { source: @image-url("assets/medscale-mark.svg"); width: 36px; height: 36px; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text { text: "MedScale"; color: Theme.nav-text; font-size: 17px; font-weight: 700; letter-spacing: -0.2px; }
                            Text { text: "CLINICAL INTELLIGENCE OS"; color: Theme.nav-subtle; font-size: 8px; letter-spacing: 1.1px; }
                        }
                    }

                    Rectangle { height: 8px; background: transparent; }

                    Text { text: "WORKSPACE"; color: Theme.nav-subtle; font-size: 8px; letter-spacing: 1.15px; }
                    NavItem { label: "Home"; glyph: ""; selected: root.active-route == "Home"; activated => { root.active-route = "Home"; } }
                    NavItem { label: "Patients"; glyph: ""; selected: root.active-route == "Patients"; activated => { root.active-route = "Patients"; } }
                    NavItem { label: "Documents"; glyph: ""; selected: root.active-route == "Documents"; activated => { root.active-route = "Documents"; } }

                    Text { text: "INTELLIGENCE"; color: Theme.nav-subtle; font-size: 8px; letter-spacing: 1.15px; }
                    NavItem { label: "Insights"; glyph: ""; selected: root.active-route == "Insights"; activated => { root.active-route = "Insights"; } }
                    NavItem { label: "Models"; glyph: ""; selected: root.active-route == "Models"; activated => { root.active-route = "Models"; } }
                    NavItem { label: "Evidence"; glyph: ""; selected: root.active-route == "Evidence"; activated => { root.active-route = "Evidence"; } }

                    Text { text: "OPERATIONS"; color: Theme.nav-subtle; font-size: 8px; letter-spacing: 1.15px; }
                    NavItem { label: "Workflows"; glyph: ""; selected: root.active-route == "Workflows"; activated => { root.active-route = "Workflows"; } }
                    NavItem { label: "Tasks"; glyph: ""; selected: root.active-route == "Tasks"; activated => { root.active-route = "Tasks"; } }
                    NavItem { label: "Messages"; glyph: ""; selected: root.active-route == "Messages"; activated => { root.active-route = "Messages"; } }

                    Text { text: "GOVERNANCE"; color: Theme.nav-subtle; font-size: 8px; letter-spacing: 1.15px; }
                    NavItem { label: "Audit Trail"; glyph: ""; selected: root.active-route == "Audit Trail"; activated => { root.active-route = "Audit Trail"; } }
                    NavItem { label: "Exports"; glyph: ""; selected: root.active-route == "Exports"; activated => { root.active-route = "Exports"; } }
                    NavItem { label: "Integrations"; glyph: ""; selected: root.active-route == "Integrations"; activated => { root.active-route = "Integrations"; } }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    Rectangle {
                        height: 76px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.graphite-raised;
                        background: Theme.graphite;
                        accessible-role: text;
                        accessible-label: "Runtime status: local-first, network default deny, model runtime state visible in Model Center";
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 3px;
                            Text { text: "RUNTIME"; color: Theme.nav-subtle; font-size: 8px; letter-spacing: 1.2px; }
                            Text { text: "LOCAL · NO EGRESS"; color: Theme.nav-text; font-size: 11px; font-weight: 650; }
                            Text { text: "v" + root.product-version; color: Theme.signal-glow; font-size: 9px; }
                        }
                    }

                    NavItem { label: "Settings"; glyph: "⚙"; selected: root.active-route == "Settings"; activated => { root.active-route = "Settings"; } }
                    NavItem { label: "About"; glyph: "ⓘ"; selected: root.active-route == "About"; activated => { root.active-route = "About"; } }
                }
            }

            VerticalLayout {
                spacing: 0px;

                topbar := Rectangle {
                    height: 64px;
                    background: Theme.surface;
                    border-width: 0px;

                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 14px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 40px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.surface-raised;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 10px;
                                Text { text: "SEARCH"; color: Theme.ink-quiet; font-size: 8px; font-weight: 650; letter-spacing: 0.9px; }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    placeholder-text: "Patients · sources · evidence · commands";
                                    accessible-label: "Global search";
                                    accepted(text) => { root.ui-action("search:" + text); }
                                }
                            }
                        }

                        Rectangle {
                            width: 156px;
                            height: 40px;
                            border-radius: 10px;
                            background: Theme.graphite;
                            accessible-role: text;
                            accessible-label: "Model Fabric status. " + root.model-runtime-summary;
                            Text {
                                text: "●  Model Fabric · LOCAL";
                                color: Theme.nav-text;
                                font-size: 9px;
                                font-weight: 650;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        ToolbarAction { label: "Commands"; activated => { root.palette-open = true; } }

                        Rectangle {
                            width: 40px;
                            border-radius: 20px;
                            background: Theme.signal-soft;
                            Text { text: "JD"; color: Theme.signal-strong; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 18px;

                        HorizontalLayout {
                            height: 78px;
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: root.active-route == "Home" ? "Clinical Workspace" : root.active-route == "Patients" ? root.patient-name : root.active-route; color: Theme.ink; font-size: 28px; font-weight: 720; letter-spacing: -0.4px; }
                                Text { text: root.active-route == "Home" ? "Trusted local clinical intelligence · evidence before authority" : root.active-route == "Patients" ? "Trusted longitudinal workspace · Synthetic demo" : root.active-route == "Insights" ? "Evidence-aware population view · Synthetic demo" : root.active-route == "Models" ? "Local model fabric · provenance, runtime and benchmark state" : root.active-route == "Evidence" ? "Pinned OpenMed evidence · measured claims only · limitations explicit" : root.active-route == "Workflows" ? "Review-first controlled-action studio · Synthetic demo" : root.active-route == "Tasks" ? "Derived outbox review queue · No second task authority" : root.active-route == "Messages" ? "Local review previews · No external transport claim" : root.active-route == "Documents" ? "Bounded document intake posture · Custody is not understanding" : root.active-route == "Audit Trail" ? "Synthetic disclosure history · Core Host remains canonical" : root.active-route == "Exports" ? "Loss-aware FHIR support · No full conformance claim" : root.active-route == "Settings" ? "Doctor truth and evidence-gated readiness" : root.active-route == "Integrations" ? "Brokered integration posture · Default deny" : root.active-route == "About" ? "Native product and attribution details" : "Unrecognized route"; color: Theme.ink-subtle; font-size: 13px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            if root.active-route == "Home": Text {
                                text: "Evidence first · action second";
                                color: Theme.signal-strong;
                                font-size: 10px;
                                font-weight: 650;
                            }
                        }

                        if root.active-route == "Models": VerticalLayout {
                            spacing: 14px;

                            Rectangle {
                                min-height: 132px;
                                border-radius: 14px;
                                background: Theme.obsidian;
                                accessible-role: groupbox;
                                accessible-label: "MedScale model fabric. " + root.model-runtime-boundary;
                                HorizontalLayout {
                                    padding: 18px;
                                    spacing: 18px;
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: "MODEL FABRIC"; color: Theme.signal-glow; font-size: 9px; letter-spacing: 1.2px; }
                                        Text { text: root.model-runtime-summary; color: Theme.nav-text; font-size: 18px; font-weight: 700; wrap: word-wrap; }
                                        Text { text: root.model-runtime-boundary; color: Theme.nav-subtle; font-size: 11px; wrap: word-wrap; }
                                    }
                                    Rectangle { width: 1px; background: Theme.graphite-raised; }
                                    VerticalLayout {
                                        width: 310px;
                                        spacing: 6px;
                                        Text { text: "HUGGING FACE"; color: Theme.signal-glow; font-size: 9px; letter-spacing: 1.2px; }
                                        Text { text: "Model source, not authority"; color: Theme.nav-text; font-size: 13px; font-weight: 650; }
                                        Text { text: root.model-source-summary; color: Theme.nav-subtle; font-size: 10px; wrap: word-wrap; }
                                    }
                                }
                            }

                            Rectangle {
                                min-height: 116px;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Local Pack operator. " + root.model-inventory-summary + ". " + root.model-operator-status;
                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        Text { text: "LOCAL PACK OPERATOR"; color: Theme.signal-strong; font-size: 9px; font-weight: 650; letter-spacing: 1px; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: root.model-operator-status; color: Theme.ink-quiet; font-size: 9px; }
                                    }
                                    Text { text: root.model-inventory-summary; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit {
                                            horizontal-stretch: 1;
                                            height: 36px;
                                            text <=> root.model-pack-path;
                                            placeholder-text: "Absolute path to a signed local Pack directory";
                                            accessible-label: "Local signed Pack directory";
                                            accepted(text) => { root.model-pack-path = text; root.ui-action("model-admit"); }
                                        }
                                        ToolbarAction { label: "Admit local Pack"; activated => { root.ui-action("model-admit"); } }
                                        ToolbarAction { label: "Refresh"; activated => { root.ui-action("model-refresh"); } }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Runtime inventory"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text { text: "Core-backed session state · qualification references are separate"; color: Theme.ink-quiet; font-size: 10px; }
                            }

                            for item in root.model-rows: Rectangle {
                                min-height: 126px;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: item.task + ". " + item.model + ". " + item.state;
                                HorizontalLayout {
                                    padding: 15px;
                                    spacing: 16px;
                                    VerticalLayout {
                                        width: 250px;
                                        spacing: 4px;
                                        Text { text: item.scope; color: Theme.signal-strong; font-size: 8px; font-weight: 650; letter-spacing: 0.8px; }
                                        Text { text: item.task; color: Theme.ink; font-size: 13px; font-weight: 680; }
                                        Text { text: item.model; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                        Text { text: item.source; color: Theme.signal-strong; font-size: 9px; font-weight: 600; }
                                    }
                                    Rectangle { width: 1px; background: Theme.border; }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text { text: "Runtime  ·  " + item.runtime; color: Theme.ink-subtle; font-size: 10px; }
                                        Text { text: "Device   ·  " + item.device; color: Theme.ink-subtle; font-size: 10px; }
                                        Text { text: "Trust      ·  " + item.trust; color: Theme.ink-subtle; font-size: 10px; }
                                        Text { text: "Evidence ·  " + item.benchmark; color: Theme.ink-quiet; font-size: 10px; wrap: word-wrap; }
                                        Text { text: "Digest    ·  " + item.digest; color: Theme.ink-quiet; font-size: 9px; wrap: word-wrap; }
                                    }
                                    StatusPill {
                                        label: item.state;
                                        accent: item.state == "CURRENT" || item.state == "QUALIFIED BASELINE" ? Theme.success : item.state == "CANDIDATE" || item.state == "CANARY" || item.state == "LAST GREEN" ? Theme.warning : item.state == "EMPTY" ? Theme.ink-quiet : Theme.danger;
                                    }
                                }
                            }
                        }

                        if root.active-route == "Evidence": VerticalLayout {
                            spacing: 14px;

                            Rectangle {
                                min-height: 148px;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "OpenMed evidence comparison. " + root.competitive-summary;
                                HorizontalLayout {
                                    padding: 18px;
                                    spacing: 18px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text { text: "EVIDENCE, NOT MARKETING"; color: Theme.signal-strong; font-size: 9px; letter-spacing: 1.2px; font-weight: 650; }
                                        Text { text: "MedScale × OpenMed"; color: Theme.ink; font-size: 22px; font-weight: 720; }
                                        Text { text: root.competitive-summary; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                    }
                                    Rectangle {
                                        width: 300px;
                                        border-radius: 11px;
                                        background: Theme.canvas;
                                        VerticalLayout {
                                            padding: 13px;
                                            spacing: 5px;
                                            Text { text: "PINNED BASELINE"; color: Theme.ink-quiet; font-size: 8px; letter-spacing: 1px; }
                                            Text { text: root.openmed-baseline; color: Theme.ink; font-size: 11px; font-weight: 650; wrap: word-wrap; }
                                            Text { text: "Every superiority claim requires exact comparative evidence."; color: Theme.ink-subtle; font-size: 9px; wrap: word-wrap; }
                                        }
                                    }
                                }
                            }

                            for item in root.competitive-evidence-rows: Rectangle {
                                min-height: 132px;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: item.capability + ". Claim state " + item.verdict + ". " + item.limitations;
                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 9px;
                                    HorizontalLayout {
                                        Text { text: item.capability; color: Theme.ink; font-size: 13px; font-weight: 680; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        StatusPill {
                                            label: item.verdict;
                                            accent: item.verdict == "UNMEASURED" ? Theme.warning : item.verdict == "ANTI-METRIC" ? Theme.ink-quiet : Theme.signal-strong;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "MEDSCALE"; color: Theme.signal-strong; font-size: 8px; letter-spacing: 1px; font-weight: 650; }
                                            Text { text: item.medscale; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                        }
                                        Rectangle { width: 1px; background: Theme.border; }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "OPENMED"; color: Theme.ink-quiet; font-size: 8px; letter-spacing: 1px; font-weight: 650; }
                                            Text { text: item.openmed; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                        }
                                    }
                                    Text { text: "Evidence · " + item.evidence; color: Theme.ink-quiet; font-size: 9px; wrap: word-wrap; }
                                    Text { text: "Limitations · " + item.limitations; color: Theme.ink-subtle; font-size: 9px; wrap: word-wrap; }
                                }
                            }
                        }

                        if root.active-route == "About": Rectangle {
                            height: 360px;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.surface;
                            accessible-role: groupbox;
                            accessible-label: "About MedScale and Slint attribution";
                            HorizontalLayout {
                                padding: 24px;
                                spacing: 28px;
                                VerticalLayout {
                                    width: 360px;
                                    spacing: 8px;
                                    Image { source: @image-url("assets/medscale-mark.svg"); width: 72px; height: 52px; }
                                    Text { text: "MedScale"; color: Theme.ink; font-size: 26px; font-weight: 700; }
                                    Text { text: "Local-first healthcare intelligence"; color: Theme.ink-subtle; font-size: 13px; }
                                    Text { text: "Version " + root.product-version; color: Theme.ink-quiet; font-size: 11px; }
                                    Text { text: "MedScale source is licensed under Apache-2.0. UI toolkit attribution is shown alongside."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                }
                                Rectangle { width: 1px; background: Theme.border; }
                                AboutSlint { horizontal-stretch: 1; vertical-stretch: 1; }
                            }
                        }

                        if root.active-route == "Patients": VerticalLayout {
                            spacing: 16px;

                            Rectangle {
                                height: 132px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Synthetic patient workspace for " + root.patient-name + ". " + root.patient-coverage-state;
                                HorizontalLayout {
                                    padding: 18px;
                                    spacing: 18px;
                                    Rectangle {
                                        width: 72px;
                                        border-radius: 22px;
                                        background: Theme.signal-soft;
                                        Text { text: "SC"; color: Theme.signal-strong; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                                    }
                                    VerticalLayout {
                                        spacing: 5px;
                                        Text { text: root.patient-name; color: Theme.ink; font-size: 20px; font-weight: 700; }
                                        Text { text: "Subject: " + root.patient-subject-ref; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { text: "Birth date: " + root.patient-birth-date; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { text: root.patient-condition-summary; color: Theme.ink; font-size: 12px; wrap: word-wrap; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    VerticalLayout {
                                        width: 300px;
                                        alignment: center;
                                        spacing: 8px;
                                        StatusPill { label: "Synthetic demo"; accent: Theme.signal; }
                                        StatusPill { label: root.patient-coverage-state; accent: root.patient-coverage-state == "Supported evidence" ? Theme.success : Theme.warning; }
                                        Text { text: root.patient-coverage-summary; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; horizontal-alignment: right; }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                SegmentTab { label: "Overview"; selected: root.patient-tab == "Overview"; activated => { root.patient-tab = "Overview"; } }
                                SegmentTab { label: "Timeline"; selected: root.patient-tab == "Timeline"; activated => { root.patient-tab = "Timeline"; } }
                                SegmentTab { label: "Labs"; selected: root.patient-tab == "Labs"; activated => { root.patient-tab = "Labs"; } }
                                SegmentTab { label: "Medications"; selected: root.patient-tab == "Medications"; activated => { root.patient-tab = "Medications"; } }
                                SegmentTab { label: "Documents"; selected: root.patient-tab == "Documents"; activated => { root.patient-tab = "Documents"; } }
                                SegmentTab { label: "Care Plan"; selected: root.patient-tab == "Care Plan"; activated => { root.patient-tab = "Care Plan"; } }
                                SegmentTab { label: "Sources"; selected: root.patient-tab == "Sources"; activated => { root.patient-tab = "Sources"; } }
                            }

                            if root.patient-tab == "Overview": HorizontalLayout {
                                spacing: 16px;
                                Rectangle {
                                    horizontal-stretch: 3;
                                    min-height: 250px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 12px;
                                        Text { text: "Trusted overview"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                        Text { text: "Identity and conditions are mapped from SubjectBriefV1. Missing or conflicting evidence is never promoted into an affirmative fact."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        Text { text: "Conditions"; color: Theme.ink-quiet; font-size: 10px; font-weight: 650; }
                                        Text { text: root.patient-condition-summary; color: Theme.ink; font-size: 13px; wrap: word-wrap; }
                                        Text { text: "Coverage"; color: Theme.ink-quiet; font-size: 10px; font-weight: 650; }
                                        Text { text: root.patient-coverage-summary; color: Theme.ink; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                HonestyPanel {
                                    horizontal-stretch: 2;
                                    title: "Authority boundary";
                                    body: "This workspace is read-only presentation. Evidence and provenance remain visible; relevance does not become clinical authority and no action is silently committed.";
                                    accent: Theme.success;
                                }
                            }

                            if root.patient-tab == "Timeline": VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    height: 44px;
                                    Text { text: "Longitudinal timeline"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    ToolbarAction { label: "Inspect sources"; glyph: "◇"; activated => { root.patient-tab = "Sources"; } }
                                }
                                Rectangle {
                                    height: 42px;
                                    background: Theme.surface-raised;
                                    HorizontalLayout {
                                        padding-left: 14px; padding-right: 14px; spacing: 12px;
                                        Text { width: 120px; text: "DATE"; color: Theme.ink-quiet; font-size: 10px; font-weight: 650; }
                                        Text { width: 150px; text: "TYPE"; color: Theme.ink-quiet; font-size: 10px; font-weight: 650; }
                                        Text { horizontal-stretch: 1; text: "LONGITUDINAL EVENT"; color: Theme.ink-quiet; font-size: 10px; font-weight: 650; }
                                        Text { width: 160px; text: "PROVENANCE"; color: Theme.ink-quiet; font-size: 10px; font-weight: 650; }
                                    }
                                }
                                for item in root.patient-timeline: Rectangle {
                                    height: 64px;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    accessible-role: text;
                                    accessible-label: item.date + ", " + item.title + ", " + item.detail + ", " + item.source;
                                    HorizontalLayout {
                                        padding-left: 14px; padding-right: 14px; spacing: 12px;
                                        Text { width: 120px; text: item.date; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { width: 150px; text: item.title; color: Theme.ink; font-size: 11px; font-weight: 650; }
                                        Text { horizontal-stretch: 1; text: item.detail; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        VerticalLayout { width: 160px; alignment: center; spacing: 2px; Text { text: item.source; color: Theme.signal-strong; font-size: 10px; } Text { text: item.status; color: Theme.ink-quiet; font-size: 9px; } }
                                    }
                                }
                            }

                            if root.patient-tab == "Labs": VerticalLayout {
                                spacing: 0px;
                                Rectangle {
                                    height: 42px; background: Theme.surface-raised;
                                    HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 12px;
                                        Text { horizontal-stretch: 1; text: "OBSERVATION"; color: Theme.ink-quiet; font-size: 10px; font-weight: 650; }
                                        Text { width: 110px; text: "VALUE"; color: Theme.ink-quiet; font-size: 10px; font-weight: 650; }
                                        Text { width: 130px; text: "COVERAGE"; color: Theme.ink-quiet; font-size: 10px; font-weight: 650; }
                                        Text { width: 160px; text: "SOURCE"; color: Theme.ink-quiet; font-size: 10px; font-weight: 650; }
                                    }
                                }
                                for item in root.patient-labs: Rectangle {
                                    height: 60px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                                    accessible-role: text;
                                    accessible-label: item.label + ", " + item.value + " " + item.unit + ", " + item.status + ", " + item.source;
                                    HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 12px;
                                        Text { horizontal-stretch: 1; text: item.label; color: Theme.ink; font-size: 12px; font-weight: 650; }
                                        Text { width: 110px; text: item.value + " " + item.unit; color: Theme.ink; font-size: 12px; }
                                        Text { width: 130px; text: item.status; color: Theme.ink-subtle; font-size: 10px; }
                                        Text { width: 160px; text: item.source; color: Theme.signal-strong; font-size: 10px; }
                                    }
                                }
                            }

                            if root.patient-tab == "Medications": HonestyPanel { title: "Medications — honest unsupported state"; body: root.patient-medications-state; accent: Theme.warning; }
                            if root.patient-tab == "Documents": HonestyPanel { title: "Documents — custody is not understanding"; body: root.patient-documents-state; accent: Theme.signal; }
                            if root.patient-tab == "Care Plan": VerticalLayout {
                                spacing: 12px;
                                HonestyPanel { title: "Care Plan — review first"; body: root.patient-care-plan-state; accent: Theme.success; }
                                QuickAction { title: "Prepare in Workflows"; subtitle: "Open review surface; do not commit here"; glyph: "⌘"; accent: Theme.signal; activated => { root.ui-action("care-plan"); } }
                            }

                            if root.patient-tab == "Sources": VerticalLayout {
                                spacing: 8px;
                                Text { text: "Evidence sources"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                Text { text: "Synthetic fixture provenance only. A source link supports inspection; it does not make a claim authoritative by itself."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                for item in root.patient-sources: Rectangle {
                                    min-height: 58px; border-radius: 12px; border-width: 1px; border-color: Theme.border; background: Theme.surface;
                                    accessible-role: text;
                                    accessible-label: "Source " + item.source-id + ". " + item.note;
                                    HorizontalLayout { padding: 12px; spacing: 14px;
                                        Text { width: 220px; text: item.source-id; color: Theme.signal-strong; font-size: 11px; font-weight: 650; }
                                        Text { horizontal-stretch: 1; text: item.note; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }

                        if root.active-route == "Insights": VerticalLayout {
                            spacing: 18px;

                            HorizontalLayout {
                                spacing: 12px;
                                MetricCard { label: "Synthetic cohort"; value: root.insights-cohort-size; delta: "Trusted projection subjects"; glyph: "◎"; accent: Theme.signal; }
                                MetricCard { label: "Evidence review"; value: root.insights-review-attention; delta: "Unresolved evidence state"; glyph: "◇"; accent: Theme.warning; }
                                MetricCard { label: "Evidence gaps"; value: root.insights-evidence-gaps; delta: "Not clinical care gaps"; glyph: "○"; accent: Theme.warning; }
                                MetricCard { label: "Present slots"; value: root.insights-present-count; delta: "Trusted presentation only"; glyph: "✓"; accent: Theme.success; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                SegmentTab { label: "Overview"; selected: root.insights-tab == "Overview"; activated => { root.insights-tab = "Overview"; } }
                                SegmentTab { label: "Cohorts"; selected: root.insights-tab == "Cohorts"; activated => { root.insights-tab = "Cohorts"; } }
                                SegmentTab { label: "Evidence"; selected: root.insights-tab == "Evidence"; activated => { root.insights-tab = "Evidence"; } }
                            }

                            if root.insights-tab == "Overview": VerticalLayout {
                                spacing: 16px;
                                HorizontalLayout {
                                    spacing: 16px;
                                    Rectangle {
                                        horizontal-stretch: 3;
                                        min-height: 310px;
                                        border-radius: 16px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: Theme.surface;
                                        accessible-role: groupbox;
                                        accessible-label: "Coverage state distribution from trusted synthetic projections";
                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 8px;
                                            Text { text: "Coverage state distribution"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                            Text { text: "Statuses remain distinct; unresolved evidence is never flattened into present."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                            Rectangle { height: 1px; background: Theme.border; }
                                            for item in root.insights-coverage: HorizontalLayout {
                                                height: 34px;
                                                spacing: 12px;
                                                accessible-role: text;
                                                accessible-label: item.label + ": " + item.value + ". " + item.detail;
                                                Text { width: 150px; text: item.label; color: Theme.ink; font-size: 11px; font-weight: 650; }
                                                Text { width: 46px; text: item.value; color: Theme.signal-strong; font-size: 13px; font-weight: 700; }
                                                Text { horizontal-stretch: 1; text: item.detail; color: Theme.ink-subtle; font-size: 10px; }
                                                Text { width: 118px; text: item.status; color: Theme.ink-subtle; font-size: 9px; horizontal-alignment: right; }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 2;
                                        min-height: 310px;
                                        border-radius: 20px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: Theme.surface;
                                        accessible-role: groupbox;
                                        accessible-label: "Contextual evidence assistant. Suggestions only; relevance is not clinical authority.";
                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 10px;
                                            HorizontalLayout {
                                                Text { text: "MedScale Assistant"; color: Theme.ink; font-size: 15px; font-weight: 680; }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                                StatusPill { label: "Evidence context"; accent: Theme.success; }
                                            }
                                            Text { text: "Deterministic local UX — no provider/model authority in this slice."; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                            assistant-query := LineEdit {
                                                placeholder-text: "Ask about coverage, cohorts, evidence, or risk limits…";
                                                accessible-label: "Population evidence assistant query";
                                                accepted(text) => { root.ui-action("insights-assistant:" + text); }
                                            }
                                            Rectangle {
                                                min-height: 106px;
                                                border-radius: 14px;
                                                background: Theme.signal-soft;
                                                accessible-role: text;
                                                accessible-label: "Assistant response: " + root.insights-assistant-answer;
                                                VerticalLayout {
                                                    padding: 14px;
                                                    spacing: 6px;
                                                    Text { text: "Suggestion"; color: Theme.signal-strong; font-size: 10px; font-weight: 700; }
                                                    Text { text: root.insights-assistant-answer; color: Theme.ink; font-size: 11px; wrap: word-wrap; }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                QuickAction { title: "Explain gaps"; subtitle: "Evidence state only"; glyph: "?"; accent: Theme.warning; activated => { root.ui-action("insights-assistant:Explain coverage gaps"); } }
                                                QuickAction { title: "Risk limits"; subtitle: "No clinical ranking"; glyph: "!"; accent: Theme.warning; activated => { root.ui-action("insights-assistant:Who is highest risk?"); } }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 16px;
                                    HonestyPanel { horizontal-stretch: 1; title: "Risk distribution boundary"; body: root.insights-risk-state; accent: Theme.warning; }
                                    HonestyPanel { horizontal-stretch: 1; title: "Trend boundary"; body: root.insights-trend-state; accent: Theme.signal; }
                                }
                                HorizontalLayout {
                                    spacing: 16px;
                                    HonestyPanel { horizontal-stretch: 1; title: "Evidence gaps"; body: root.insights-gap-state; accent: Theme.warning; }
                                    HonestyPanel { horizontal-stretch: 1; title: "Review recommendation"; body: root.insights-recommendation-state; accent: Theme.success; }
                                }
                            }

                            if root.insights-tab == "Cohorts": Rectangle {
                                min-height: 390px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Synthetic cohort explorer with evidence review state";
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 0px;
                                    Text { text: "Cohort explorer"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                    Text { text: "Synthetic subjects only. Condition text is shown only when present in trusted presentation; unresolved status remains explicit."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                    Rectangle { height: 12px; background: transparent; }
                                    HorizontalLayout { height: 38px; spacing: 12px;
                                        Text { width: 160px; text: "SUBJECT"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; }
                                        Text { width: 210px; text: "CONDITION"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; }
                                        Text { horizontal-stretch: 1; text: "EVIDENCE STATE"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; }
                                        Text { width: 150px; text: "REVIEW"; color: Theme.ink-quiet; font-size: 9px; font-weight: 700; horizontal-alignment: right; }
                                    }

                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Audio source " + item.label + ", " + item.kind + ", " + item.detail + ", health " + item.health;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; vertical-alignment: center; text: item.label + " · " + item.kind + " · " + item.detail; color: Theme.ink; font-size: 12px; wrap: word-wrap; }
                                    StatusPill { label: item.health; accent: item.health == "ok" ? Theme.success : Theme.warning; }
                                    QuickAction { width: 110px; title: "Segment"; subtitle: "No speech engine"; glyph: ""; accent: Theme.signal; activated => { root.ui-action("audio-segment:" + item.id); } }
                                }

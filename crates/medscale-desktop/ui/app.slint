                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: "Data sources follow the active project"; color: Theme.ink; font-size: 12px; font-weight: 680; }
                                        Text { text: root.data-status; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    }
                                    ToolbarAction { label: "Refresh"; activated => { root.ui-action("data-refresh"); } }
                                    ToolbarAction { label: "Import"; activated => { root.ui-action("data-import"); } }
                                    ToolbarAction { label: "Re-check"; activated => { root.ui-action("data-refresh-source"); } }
                                    ToolbarAction { label: "Ack schema"; activated => { root.ui-action("data-refresh-source-force"); } }
                                }
                            }

                            Text { text: "Sources"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.data-sources: Rectangle {

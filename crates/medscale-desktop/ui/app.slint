                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: item.name + ", revision " + item.revision;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;

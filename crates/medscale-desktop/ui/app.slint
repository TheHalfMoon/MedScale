                        }

                        if root.active-route == "Home": VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                spacing: 16px;

                                Rectangle {
                                    horizontal-stretch: 3;
                                    min-height: 210px;
                                    border-radius: Theme.radius-panel;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: groupbox;
                                    accessible-label: "Current clinical workspace for Synthetic Subject A";
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 9px;
                                        Text { text: "Synthetic Subject A"; color: Theme.ink; font-size: 24px; font-weight: 720; letter-spacing: -0.3px; }
                                        Text { text: "Condition evidence present · coverage unknown · one conflicting source requires review"; color: Theme.ink-subtle; font-family: "Source Serif 4"; font-size: 13px; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        HorizontalLayout {
                                            spacing: 18px;
                                            VerticalLayout { spacing: 2px; Text { text: "SOURCE TRAIL"; color: Theme.ink-quiet; font-size: 11px; letter-spacing: 1px; } Text { text: "3 admitted sources"; color: Theme.ink; font-size: 11px; font-weight: 650; } }
                                            VerticalLayout { spacing: 2px; Text { text: "IDENTITY"; color: Theme.ink-quiet; font-size: 11px; letter-spacing: 1px; } Text { text: "No silent merge"; color: Theme.ink; font-size: 11px; font-weight: 650; } }
                                            VerticalLayout { spacing: 2px; Text { text: "AUTHORITY"; color: Theme.ink-quiet; font-size: 11px; letter-spacing: 1px; } Text { text: "Core Host"; color: Theme.ink; font-size: 11px; font-weight: 650; } }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                        HorizontalLayout {
                                            spacing: 10px;
                                            QuickAction { title: "Open patient record"; subtitle: "Timeline, coverage, sources"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Patients"; } }
                                            QuickAction { title: "Review evidence"; subtitle: "Trace claims to sources"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Evidence"; } }
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 2;
                                    min-height: 210px;
                                    border-radius: Theme.radius-panel;
                                    background: Theme.obsidian;
                                    accessible-role: groupbox;
                                    accessible-label: "Inspectable AI layer. " + root.model-runtime-summary;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 9px;
                                        HorizontalLayout {
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            StatusPill { label: "INSPECTABLE"; accent: Theme.signal; text-color: Theme.nav-text; }
                                        }
                                        Text { text: "AI is visible, not implied."; color: Theme.nav-text; font-size: 18px; font-weight: 700; }
                                        Text { text: root.model-runtime-summary; color: Theme.nav-subtle; font-size: 11px; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: Theme.graphite-raised; }
                                        Text { text: "HF source ≠ runtime authority. Every model must carry task, digest, rights, device and benchmark evidence."; color: Theme.nav-subtle; font-size: 11px; wrap: word-wrap; }
                                        QuickAction { title: "Inspect Model Center"; subtitle: "Runtime · source · trust · benchmark"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Models"; } }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "Clinical flow"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                Rectangle {
                                    min-height: 132px;
                                    border-radius: Theme.radius-panel;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    accessible-role: groupbox;
                                    accessible-label: "Clinical flow: prepare, understand, act";
                                    HorizontalLayout {
                                        padding: 18px;
                                        spacing: 18px;
                                        VerticalLayout {
                                            horizontal-stretch: 1; spacing: 5px;
                                            Text { text: "01  PREPARE"; color: Theme.signal-strong; font-size: 11px; font-weight: 700; letter-spacing: 0.9px; }
                                            Text { text: "Know the record before the encounter"; color: Theme.ink; font-size: 13px; font-weight: 650; wrap: word-wrap; }
                                            Text { text: "Surface longitudinal context, source freshness, conflicts and coverage before work begins."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        }
                                        Rectangle { width: 1px; background: Theme.border; }
                                        VerticalLayout {
                                            horizontal-stretch: 1; spacing: 5px;
                                            Text { text: "02  UNDERSTAND"; color: Theme.signal-strong; font-size: 11px; font-weight: 700; letter-spacing: 0.9px; }
                                            Text { text: "Keep intelligence tied to evidence"; color: Theme.ink; font-size: 13px; font-weight: 650; wrap: word-wrap; }
                                            Text { text: "Assistant and model outputs remain inspectable proposals with source links and explicit limits."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        }
                                        Rectangle { width: 1px; background: Theme.border; }
                                        VerticalLayout {
                                            horizontal-stretch: 1; spacing: 5px;
                                            Text { text: "03  ACT"; color: Theme.signal-strong; font-size: 11px; font-weight: 700; letter-spacing: 0.9px; }
                                            Text { text: "Review before anything consequential"; color: Theme.ink; font-size: 13px; font-weight: 650; wrap: word-wrap; }
                                            Text { text: "Controlled actions bind payload identity, durable outbox state and UNKNOWN reconciliation."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                min-height: 286px;
                                border-radius: Theme.radius-panel;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 9px;
                                    HorizontalLayout {
                                        Text { text: "Review queue"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: "Synthetic demo · not a clinical risk ranking"; color: Theme.ink-quiet; font-size: 11px; }
                                    }
                                    Rectangle { height: 1px; background: Theme.border; }
                                    HorizontalLayout { height: 44px; spacing: 12px; Text { width: 180px; text: "Synthetic Subject A"; color: Theme.ink; font-size: 11px; font-weight: 650; } Text { text: "Condition evidence present"; color: Theme.ink-subtle; font-size: 11px; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "Evidence review"; accent: Theme.warning; } }
                                    Rectangle { height: 1px; background: Theme.border; }
                                    HorizontalLayout { height: 44px; spacing: 12px; Text { width: 180px; text: "Synthetic Subject B"; color: Theme.ink; font-size: 11px; font-weight: 650; } Text { text: "Coverage evidence unknown"; color: Theme.ink-subtle; font-size: 11px; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "Coverage gap"; accent: Theme.warning; } }
                                    Rectangle { height: 1px; background: Theme.border; }
                                    HorizontalLayout { height: 44px; spacing: 12px; Text { width: 180px; text: "Synthetic Subject C"; color: Theme.ink; font-size: 11px; font-weight: 650; } Text { text: "Observation evidence available"; color: Theme.ink-subtle; font-size: 11px; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "New evidence"; accent: Theme.signal; } }
                                    Rectangle { height: 1px; background: Theme.border; }
                                    HorizontalLayout { height: 44px; spacing: 12px; Text { width: 180px; text: "Synthetic Subject D"; color: Theme.ink; font-size: 11px; font-weight: 650; } Text { text: "Conflicting evidence"; color: Theme.ink-subtle; font-size: 11px; } Rectangle { horizontal-stretch: 1; background: transparent; } StatusPill { label: "Unresolved"; accent: Theme.danger; } }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        QuickAction { title: "Open all patients"; subtitle: "Longitudinal workspace"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Patients"; } }
                                        QuickAction { title: "Open proof ledger"; subtitle: "Inspect pinned OpenMed claim states"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Evidence"; } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.palette-open: Rectangle {
        x: parent.width / 2 - 270px;
        y: 104px;
        width: 540px;
        height: 338px;
        border-radius: Theme.radius-panel;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        accessible-role: groupbox;
        accessible-label: "MedScale command palette";
        drop-shadow-blur: 28px;
        drop-shadow-color: #15182B22;
        drop-shadow-offset-y: 10px;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            Text { text: "Command palette"; color: Theme.ink; font-size: 16px; font-weight: 700; }
            palette-search := AdaptiveLineEdit { placeholder: "Search commands…"; accessible-name: "Command palette search"; }
            QuickAction { title: "Go to Patients"; subtitle: "Open patient workspace"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Patients"; root.palette-open = false; } }
            QuickAction { title: "Open Models"; subtitle: "Inspect local model/runtime truth"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Models"; root.palette-open = false; } }
            QuickAction { title: "Open Evidence"; subtitle: "MedScale × OpenMed proof ledger"; glyph: ""; accent: Theme.signal; activated => { root.active-route = "Evidence"; root.palette-open = false; } }
        }
    }
}

                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: item.name; color: Theme.ink; font-size: 12px; font-weight: 680; wrap: word-wrap; }
                                        Text { text: item.id + " · rev " + item.revision; color: Theme.ink-quiet; font-size: 11px; }
                                    }
                                    QuickAction { width: 110px; title: "Open"; subtitle: "Threads/Tasks"; glyph: ""; accent: Theme.signal; activated => { root.ui-action("collab-room-open:" + item.id); } }
                                }
                            }

                            if root.collab-active-room-id != "": VerticalLayout {
                                spacing: 12px;

                                Text { text: "Threads (comments/review)"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                HorizontalLayout {
                                    spacing: 8px;

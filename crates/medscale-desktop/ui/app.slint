                        if root.active-route == "Privacy": VerticalLayout {
                            spacing: 14px;
                            HonestyPanel { title: "Privacy Gate boundary"; body: "Unclassified artifacts are treated as local_phi and never leave · de-identified outputs are new artifacts with a receipt · automated recognition can miss values, so no receipt claims data is free of PHI · every egress decision is made and stored by Core; this screen sends nothing"; accent: Theme.success; }

                            Rectangle {
                                min-height: 110px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Egress check. " + root.privacy-status;
                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 6px;
                                    Text { text: "Egress check follows the active project · profiles and transforms use the CLI"; color: Theme.ink; font-size: 12px; font-weight: 680; }
                                    Text { text: root.privacy-status; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.privacy-artifact-input; placeholder: "Artifact id"; accessible-name: "Artifact id for egress check"; }
                                        AdaptiveLineEdit { horizontal-stretch: 1; text <=> root.privacy-boundary-input; placeholder: "Boundary, e.g. browse or hub"; accessible-name: "Egress boundary"; }
                                        ToolbarAction { label: "Check"; activated => { root.ui-action("privacy-egress-check"); } }
                                        ToolbarAction { label: "Refresh"; activated => { root.ui-action("privacy-refresh"); } }
                                    }
                                    if root.privacy-last-decision != "": Text { text: root.privacy-last-decision; color: Theme.ink; font-size: 11px; wrap: word-wrap; accessible-role: text; accessible-label: "Last egress decision: " + root.privacy-last-decision; }
                                }
                            }

                            Text { text: "Classifications"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.privacy-classifications: Rectangle {
                                min-height: 40px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: text;
                                accessible-label: "Artifact " + item.artifact-id + ", " + item.data-class + ", basis " + item.basis;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; vertical-alignment: center; text: item.artifact-id + " · rev " + item.revision; color: Theme.ink; font-size: 12px; }
                                    Text { vertical-alignment: center; text: item.basis; color: Theme.ink-quiet; font-size: 11px; }
                                    StatusPill { label: item.data-class; accent: item.data-class == "public" ? Theme.success : item.data-class == "local_phi" ? Theme.danger : Theme.warning; }
                                }
                            }

                            Text { text: "De-identification receipts"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.privacy-receipts: Rectangle {
                                min-height: 52px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Receipt " + item.id + ", " + item.status + ", residual " + item.residual;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; vertical-alignment: center; text: item.source + " → " + item.output + " · " + item.residual; color: Theme.ink; font-size: 12px; wrap: word-wrap; }
                                    StatusPill { label: item.status; accent: item.status == "valid" ? Theme.success : Theme.danger; }
                                    if item.status == "valid": QuickAction { width: 100px; title: "Revoke"; subtitle: "Stops egress"; glyph: ""; accent: Theme.danger; activated => { root.ui-action("privacy-receipt-revoke:" + item.id + ":" + item.revision); } }
                                }
                            }

                            Text { text: "Egress decisions (newest first)"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                            for item in root.privacy-decisions: Rectangle {
                                min-height: 40px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: text;
                                accessible-label: "Decision for " + item.artifact-id + " to " + item.boundary + ": " + item.outcome + ", " + item.reason;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { horizontal-stretch: 1; vertical-alignment: center; text: item.artifact-id + " → " + item.boundary; color: Theme.ink; font-size: 12px; }
                                    Text { vertical-alignment: center; text: item.reason; color: Theme.ink-quiet; font-size: 11px; }
                                    StatusPill { label: item.outcome; accent: item.outcome == "allow" ? Theme.success : Theme.danger; }
                                }
                            }
                        }

                        if root.active-route == "Models": VerticalLayout {
                            spacing: 14px;

                            Rectangle {
                                min-height: 154px;
                                border-radius: Theme.radius-panel;
                                background: Theme.obsidian;
                                accessible-role: groupbox;
                                accessible-label: "MedScale model fabric. " + root.model-runtime-boundary;
                                HorizontalLayout {
                                    padding: 18px;
                                    spacing: 18px;
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: root.model-runtime-summary; color: Theme.nav-text; font-size: 18px; font-weight: 700; wrap: word-wrap; }
                                        Text { text: root.model-runtime-boundary; color: Theme.nav-subtle; font-size: 11px; wrap: word-wrap; }
                                    }
                                    Rectangle { width: 1px; background: Theme.graphite-raised; }
                                    VerticalLayout {
                                        width: 310px;
                                        spacing: 6px;
                                        Text { text: "Model source, not authority"; color: Theme.nav-text; font-size: 13px; font-weight: 650; }
                                        Text { text: root.model-source-summary; color: Theme.nav-subtle; font-size: 11px; wrap: word-wrap; }
                                    }
                                }
                            }

                            Rectangle {
                                min-height: 116px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Local Pack operator. " + root.model-inventory-summary + ". " + root.model-operator-status;
                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        Text { text: "LOCAL PACK OPERATOR"; color: Theme.signal-strong; font-size: 11px; font-weight: 650; letter-spacing: 1px; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: root.model-operator-status; color: Theme.ink-quiet; font-size: 11px; }
                                    }
                                    Text { text: root.model-inventory-summary; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit {
                                            horizontal-stretch: 1;
                                            text <=> root.model-pack-path;
                                            placeholder: "Absolute path to a signed local Pack directory";
                                            accessible-name: "Local signed Pack directory";
                                            accepted(text) => { root.model-pack-path = text; root.ui-action("model-admit"); }
                                        }
                                        ToolbarAction { label: "Admit local Pack"; activated => { root.ui-action("model-admit"); } }
                                        ToolbarAction { label: "Refresh"; activated => { root.ui-action("model-refresh"); } }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Runtime inventory"; color: Theme.ink; font-size: 14px; font-weight: 680; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text { text: "Core-backed session state · qualification references are separate"; color: Theme.ink-quiet; font-size: 11px; }
                            }

                            for item in root.model-rows: Rectangle {
                                min-height: 126px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: item.task + ". " + item.model + ". " + item.state;
                                HorizontalLayout {
                                    padding: 15px;
                                    spacing: 16px;
                                    VerticalLayout {
                                        width: 250px;
                                        spacing: 4px;
                                        Text { text: item.scope; color: Theme.signal-strong; font-size: 11px; font-weight: 650; letter-spacing: 0.8px; }
                                        Text { text: item.task; color: Theme.ink; font-size: 13px; font-weight: 680; }
                                        Text { text: item.model; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        Text { text: item.source; color: Theme.signal-strong; font-size: 11px; font-weight: 600; }
                                    }
                                    Rectangle { width: 1px; background: Theme.border; }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text { text: "Runtime  ·  " + item.runtime; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { text: "Device   ·  " + item.device; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { text: "Trust      ·  " + item.trust; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { text: "Evidence ·  " + item.benchmark; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                        Text { text: "Digest    ·  " + item.digest; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    }
                                    StatusPill {
                                        label: item.state;
                                        accent: item.state == "CURRENT" || item.state == "QUALIFIED BASELINE" ? Theme.success : item.state == "CANDIDATE" || item.state == "CANARY" || item.state == "LAST GREEN" ? Theme.warning : item.state == "EMPTY" ? Theme.ink-quiet : Theme.danger;
                                    }
                                }
                            }
                        }

                        if root.active-route == "Evidence": VerticalLayout {
                            spacing: 14px;

                            Rectangle {
                                min-height: 148px;
                                border-radius: Theme.radius-panel;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "OpenMed evidence comparison. " + root.competitive-summary;
                                HorizontalLayout {
                                    padding: 18px;
                                    spacing: 18px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text { text: "MedScale × OpenMed"; color: Theme.ink; font-size: 22px; font-weight: 720; }
                                        Text { text: root.competitive-summary; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                    }
                                    Rectangle {
                                        width: 300px;
                                        border-radius: 11px;
                                        background: Theme.canvas;
                                        VerticalLayout {
                                            padding: 13px;
                                            spacing: 5px;
                                            Text { text: "PINNED BASELINE"; color: Theme.ink-quiet; font-size: 11px; letter-spacing: 1px; }
                                            Text { text: root.openmed-baseline; color: Theme.ink; font-size: 11px; font-weight: 650; wrap: word-wrap; }
                                            Text { text: "Every superiority claim requires exact comparative evidence."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        }
                                    }
                                }
                            }

                            for item in root.competitive-evidence-rows: Rectangle {
                                min-height: 132px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: item.capability + ". Claim state " + item.verdict + ". " + item.limitations;
                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 9px;
                                    HorizontalLayout {
                                        Text { text: item.capability; color: Theme.ink; font-size: 13px; font-weight: 680; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        StatusPill {
                                            label: item.verdict;
                                            accent: item.verdict == "UNMEASURED" ? Theme.warning : item.verdict == "ANTI-METRIC" ? Theme.ink-quiet : Theme.signal-strong;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "MEDSCALE"; color: Theme.signal-strong; font-size: 11px; letter-spacing: 1px; font-weight: 650; }
                                            Text { text: item.medscale; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        }
                                        Rectangle { width: 1px; background: Theme.border; }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "OPENMED"; color: Theme.ink-quiet; font-size: 11px; letter-spacing: 1px; font-weight: 650; }
                                            Text { text: item.openmed; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        }
                                    }
                                    Text { text: "Evidence · " + item.evidence; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    Text { text: "Limitations · " + item.limitations; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                        }

                        if root.active-route == "About": Rectangle {
                            height: 360px;
                            border-radius: Theme.radius-panel;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.surface;
                            accessible-role: groupbox;
                            accessible-label: "About MedScale and Slint attribution";
                            HorizontalLayout {
                                padding: 24px;
                                spacing: 28px;
                                VerticalLayout {
                                    width: 360px;
                                    spacing: 8px;
                                    Image { source: @image-url("assets/medscale-mark.svg"); width: 72px; height: 52px; }
                                    Text { text: "MedScale"; color: Theme.ink; font-size: 26px; font-weight: 700; }
                                    Text { text: "Local-first healthcare intelligence"; color: Theme.ink-subtle; font-size: 13px; }
                                    Text { text: "Version " + root.product-version; color: Theme.ink-quiet; font-size: 11px; }
                                    Text { text: "MedScale source is licensed under Apache-2.0. UI toolkit attribution is shown alongside."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                }
                                Rectangle { width: 1px; background: Theme.border; }
                                AboutSlint { horizontal-stretch: 1; vertical-stretch: 1; }
                            }
                        }

                        if root.active-route == "Patients": VerticalLayout {
                            spacing: 16px;

                            Rectangle {
                                height: 132px;
                                border-radius: Theme.radius-panel;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Synthetic patient workspace for " + root.patient-name + ". " + root.patient-coverage-state;
                                HorizontalLayout {
                                    padding: 18px;
                                    spacing: 18px;
                                    Rectangle {
                                        width: 72px;
                                        border-radius: 22px;
                                        background: Theme.signal-soft;
                                        Text { text: "SC"; color: Theme.signal-strong; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                                    }
                                    VerticalLayout {
                                        spacing: 5px;
                                        Text { text: root.patient-name; color: Theme.ink; font-size: 20px; font-weight: 700; }
                                        Text { text: "Subject: " + root.patient-subject-ref; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { text: "Birth date: " + root.patient-birth-date; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { text: root.patient-condition-summary; color: Theme.ink; font-size: 12px; wrap: word-wrap; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    VerticalLayout {
                                        width: 300px;
                                        alignment: center;
                                        spacing: 8px;
                                        StatusPill { label: "Synthetic demo"; accent: Theme.signal; }
                                        StatusPill { label: root.patient-coverage-state; accent: root.patient-coverage-state == "Supported evidence" ? Theme.success : Theme.warning; }
                                        Text { text: root.patient-coverage-summary; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; horizontal-alignment: right; }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                SegmentTab { label: "Overview"; selected: root.patient-tab == "Overview"; activated => { root.patient-tab = "Overview"; } }
                                SegmentTab { label: "Timeline"; selected: root.patient-tab == "Timeline"; activated => { root.patient-tab = "Timeline"; } }
                                SegmentTab { label: "Labs"; selected: root.patient-tab == "Labs"; activated => { root.patient-tab = "Labs"; } }
                                SegmentTab { label: "Medications"; selected: root.patient-tab == "Medications"; activated => { root.patient-tab = "Medications"; } }
                                SegmentTab { label: "Documents"; selected: root.patient-tab == "Documents"; activated => { root.patient-tab = "Documents"; } }
                                SegmentTab { label: "Care Plan"; selected: root.patient-tab == "Care Plan"; activated => { root.patient-tab = "Care Plan"; } }
                                SegmentTab { label: "Sources"; selected: root.patient-tab == "Sources"; activated => { root.patient-tab = "Sources"; } }
                            }

                            if root.patient-tab == "Overview": HorizontalLayout {
                                spacing: 16px;
                                Rectangle {
                                    horizontal-stretch: 3;
                                    min-height: 250px;
                                    border-radius: Theme.radius-panel;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 12px;
                                        Text { text: "Trusted overview"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                        Text { text: "Identity and conditions are mapped from SubjectBriefV1. Missing or conflicting evidence is never promoted into an affirmative fact."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        Text { text: "Conditions"; color: Theme.ink-quiet; font-size: 11px; font-weight: 650; }
                                        Text { text: root.patient-condition-summary; color: Theme.ink; font-size: 13px; wrap: word-wrap; }
                                        Text { text: "Coverage"; color: Theme.ink-quiet; font-size: 11px; font-weight: 650; }
                                        Text { text: root.patient-coverage-summary; color: Theme.ink; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                HonestyPanel {
                                    horizontal-stretch: 2;
                                    title: "Authority boundary";
                                    body: "This workspace is read-only presentation. Evidence and provenance remain visible; relevance does not become clinical authority and no action is silently committed.";
                                    accent: Theme.success;
                                }
                            }

                            if root.patient-tab == "Timeline": VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    height: 44px;
                                    Text { text: "Longitudinal timeline"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    ToolbarAction { label: "Inspect sources"; glyph: "◇"; activated => { root.patient-tab = "Sources"; } }
                                }
                                Rectangle {
                                    height: 42px;
                                    background: Theme.surface-raised;
                                    HorizontalLayout {
                                        padding-left: 14px; padding-right: 14px; spacing: 12px;
                                        Text { width: 120px; text: "DATE"; color: Theme.ink-quiet; font-size: 11px; font-weight: 650; }
                                        Text { width: 150px; text: "TYPE"; color: Theme.ink-quiet; font-size: 11px; font-weight: 650; }
                                        Text { horizontal-stretch: 1; text: "LONGITUDINAL EVENT"; color: Theme.ink-quiet; font-size: 11px; font-weight: 650; }
                                        Text { width: 160px; text: "PROVENANCE"; color: Theme.ink-quiet; font-size: 11px; font-weight: 650; }
                                    }
                                }
                                for item in root.patient-timeline: Rectangle {
                                    height: 64px;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    accessible-role: text;
                                    accessible-label: item.date + ", " + item.title + ", " + item.detail + ", " + item.source;
                                    HorizontalLayout {
                                        padding-left: 14px; padding-right: 14px; spacing: 12px;
                                        Text { width: 120px; text: item.date; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { width: 150px; text: item.title; color: Theme.ink; font-size: 11px; font-weight: 650; }
                                        Text { horizontal-stretch: 1; text: item.detail; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                        VerticalLayout { width: 160px; alignment: center; spacing: 2px; Text { text: item.source; color: Theme.signal-strong; font-size: 11px; } Text { text: item.status; color: Theme.ink-quiet; font-size: 11px; } }
                                    }
                                }
                            }

                            if root.patient-tab == "Labs": VerticalLayout {
                                spacing: 0px;
                                Rectangle {
                                    height: 42px; background: Theme.surface-raised;
                                    HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 12px;
                                        Text { horizontal-stretch: 1; text: "OBSERVATION"; color: Theme.ink-quiet; font-size: 11px; font-weight: 650; }
                                        Text { width: 110px; text: "VALUE"; color: Theme.ink-quiet; font-size: 11px; font-weight: 650; }
                                        Text { width: 130px; text: "COVERAGE"; color: Theme.ink-quiet; font-size: 11px; font-weight: 650; }
                                        Text { width: 160px; text: "SOURCE"; color: Theme.ink-quiet; font-size: 11px; font-weight: 650; }
                                    }
                                }
                                for item in root.patient-labs: Rectangle {
                                    height: 60px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                                    accessible-role: text;
                                    accessible-label: item.label + ", " + item.value + " " + item.unit + ", " + item.status + ", " + item.source;
                                    HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 12px;
                                        Text { horizontal-stretch: 1; text: item.label; color: Theme.ink; font-size: 12px; font-weight: 650; }
                                        Text { width: 110px; text: item.value + " " + item.unit; color: Theme.ink; font-size: 12px; }
                                        Text { width: 130px; text: item.status; color: Theme.ink-subtle; font-size: 11px; }
                                        Text { width: 160px; text: item.source; color: Theme.signal-strong; font-size: 11px; }
                                    }
                                }
                            }

                            if root.patient-tab == "Medications": HonestyPanel { title: "Medications — honest unsupported state"; body: root.patient-medications-state; accent: Theme.warning; }
                            if root.patient-tab == "Documents": HonestyPanel { title: "Documents — custody is not understanding"; body: root.patient-documents-state; accent: Theme.signal; }
                            if root.patient-tab == "Care Plan": VerticalLayout {
                                spacing: 12px;
                                HonestyPanel { title: "Care Plan — review first"; body: root.patient-care-plan-state; accent: Theme.success; }
                                QuickAction { title: "Prepare in Workflows"; subtitle: "Open review surface; do not commit here"; glyph: "⌘"; accent: Theme.signal; activated => { root.ui-action("care-plan"); } }
                            }

                            if root.patient-tab == "Sources": VerticalLayout {
                                spacing: 8px;
                                Text { text: "Evidence sources"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                Text { text: "Synthetic fixture provenance only. A source link supports inspection; it does not make a claim authoritative by itself."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                for item in root.patient-sources: Rectangle {
                                    min-height: 58px; border-radius: Theme.radius-compact; border-width: 1px; border-color: Theme.border; background: Theme.surface;
                                    accessible-role: text;
                                    accessible-label: "Source " + item.source-id + ". " + item.note;
                                    HorizontalLayout { padding: 12px; spacing: 14px;
                                        Text { width: 220px; text: item.source-id; color: Theme.signal-strong; font-size: 11px; font-weight: 650; }
                                        Text { horizontal-stretch: 1; text: item.note; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }

                        if root.active-route == "Insights": VerticalLayout {
                            spacing: 18px;

                            HorizontalLayout {
                                spacing: 12px;
                                MetricCard { label: "Synthetic cohort"; value: root.insights-cohort-size; delta: "Trusted projection subjects"; glyph: "◎"; accent: Theme.signal; }
                                MetricCard { label: "Evidence review"; value: root.insights-review-attention; delta: "Unresolved evidence state"; glyph: "◇"; accent: Theme.warning; }
                                MetricCard { label: "Evidence gaps"; value: root.insights-evidence-gaps; delta: "Not clinical care gaps"; glyph: "○"; accent: Theme.warning; }
                                MetricCard { label: "Present slots"; value: root.insights-present-count; delta: "Trusted presentation only"; glyph: "✓"; accent: Theme.success; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                SegmentTab { label: "Overview"; selected: root.insights-tab == "Overview"; activated => { root.insights-tab = "Overview"; } }
                                SegmentTab { label: "Cohorts"; selected: root.insights-tab == "Cohorts"; activated => { root.insights-tab = "Cohorts"; } }
                                SegmentTab { label: "Evidence"; selected: root.insights-tab == "Evidence"; activated => { root.insights-tab = "Evidence"; } }
                            }

                            if root.insights-tab == "Overview": VerticalLayout {
                                spacing: 16px;
                                HorizontalLayout {
                                    spacing: 16px;
                                    Rectangle {
                                        horizontal-stretch: 3;
                                        min-height: 310px;
                                        border-radius: Theme.radius-panel;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: Theme.surface;
                                        accessible-role: groupbox;
                                        accessible-label: "Coverage state distribution from trusted synthetic projections";
                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 8px;
                                            Text { text: "Coverage state distribution"; color: Theme.ink; font-size: 15px; font-weight: 650; }
                                            Text { text: "Statuses remain distinct; unresolved evidence is never flattened into present."; color: Theme.ink-subtle; font-size: 11px; wrap: word-wrap; }
                                            Rectangle { height: 1px; background: Theme.border; }
                                            for item in root.insights-coverage: HorizontalLayout {
                                                height: 34px;
                                                spacing: 12px;
                                                accessible-role: text;

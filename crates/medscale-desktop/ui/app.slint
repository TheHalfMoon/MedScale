                                                    Text { text: item.detail; color: Theme.ink-subtle; font-size: 10px; wrap: word-wrap; }
                                                }
                                                StatusPill { label: item.state; accent: item.state == "Fail closed" ? Theme.coral : item.state == "Required" ? Theme.amber : Theme.pine; }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 2;
                                    spacing: 12px;
                                    HonestyPanel { title: "Authority boundary"; body: root.workflow-action-boundary; accent: Theme.pine; }
                                    HonestyPanel { title: "Task semantics"; body: root.workflow-task-boundary; accent: Theme.blurple; }
                                    QuickAction { title: "Open review tasks"; subtitle: "Derived from durable outbox state"; glyph: "✓"; accent: Theme.blurple; activated => { root.active-route = "Tasks"; } }
                                    QuickAction { title: "Open message previews"; subtitle: "No external send from this UI"; glyph: "✉"; accent: Theme.pine; activated => { root.active-route = "Messages"; } }
                                }
                            }
                        }

                        if root.active-route == "Tasks": VerticalLayout {
                            spacing: 16px;
                            HonestyPanel { title: "Derived review queue"; body: root.workflow-task-boundary; accent: Theme.blurple; }

                                        Text { horizontal-stretch: 1; text: "NEXT SAFE STEP"; color: Theme.ink-quiet; font-size: 11px; font-weight: 700; }
                                        Text { width: 130px; text: "ACTION"; color: Theme.ink-quiet; font-size: 11px; font-weight: 700; horizontal-alignment: right; }

                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        AdaptiveLineEdit {
                                            horizontal-stretch: 1;
                                            text <=> root.data-columns-input;
                                            placeholder: "Select columns (comma separated, optional)";
                                            accessible-name: "Transform select columns";
                                        }
                                        AdaptiveLineEdit {
                                            width: 130px;
                                            text <=> root.data-filter-col;
                                            placeholder: "Filter column";
                                            accessible-name: "Transform filter column";
                                        }
                                        AdaptiveLineEdit {
                                            width: 110px;
                                            text <=> root.data-filter-op;
                                            placeholder: "equals";
                                            accessible-name: "Transform filter op";
                                        }
                                        AdaptiveLineEdit {
                                            width: 130px;
                                            text <=> root.data-filter-value;
                                            placeholder: "Filter value";
                                            accessible-name: "Transform filter value";
                                        }
                                        AdaptiveLineEdit {
                                            width: 130px;
                                            text <=> root.data-sort-input;
                                            placeholder: "Sort column[:desc]";
                                            accessible-name: "Transform sort";
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ToolbarAction { label: "Save grid view"; activated => { root.ui-action("data-view-grid"); } }
                                        ToolbarAction { label: "Apply transform"; activated => { root.ui-action("data-transform-apply"); } }
                                    }
                                }
                            }
                        }

                        if root.active-route == "Collaboration": VerticalLayout {
                            spacing: 14px;
                            HonestyPanel { title: "Collaboration authority boundary"; body: "Rooms/threads/tasks are membership-gated, independent of Core capability grants · an approval decision never triggers a canonical/external effect · notes preserve conflicting edits, never overwrite"; accent: Theme.success; }

                            Rectangle {
                                min-height: 64px;
                                border-radius: Theme.radius-compact;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                accessible-role: groupbox;
                                accessible-label: "Rooms. " + root.collab-status;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: "Rooms follow the active project"; color: Theme.ink; font-size: 12px; font-weight: 680; }
                                        Text { text: root.collab-status; color: Theme.ink-quiet; font-size: 11px; wrap: word-wrap; }
                                    }
